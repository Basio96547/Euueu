---
import '@talisham/ui/tokens.css';
import '@talisham/ui/base.css';
import { currentFx, isDemoMode, catalogSource } from '../lib/catalog';
import BottomNav from '../components/BottomNav.astro';
import Footer from '../components/Footer.astro';
import { SITE, organizationLd, websiteLd, graph } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'search' | 'cart' | 'account';
  /** أنواع schema خاصة بالصفحة — تُضاف إلى رسم الموقع الثابت */
  schema?: unknown[];
  /** صفحةٌ لا معنى لفهرستها: نتيجةُ مقارنةٍ أو نتيجةُ بحث */
  noindex?: boolean;
  /** حين يكون للصفحة عنوانٌ قانونيّ واحد غير المسار الحالي */
  canonical?: string;
}

const {
  title, description = 'متجر الهواتف الجوالة في سوريا — دفع عند الاستلام',
  active = 'home', schema = [], noindex = false, canonical,
} = Astro.props;
const fx = currentFx();
const demo = isDemoMode();
const full = `${title} | تالي شام`;

/*
  العنوان القانونيّ للصفحة.
  بلا تصريحٍ به تصير ‎/c/smartphones‎ و‎/c/smartphones/‎ و‎/c/smartphones/?x=1‎
  ثلاثَ صفحاتٍ متطابقة في نظر محرك البحث، تتقاسم ثقة الرابط الواحد
  وتُضعف بعضها. والتصريح يجمعها في واحدة.
*/
const base = (Astro.site?.href ?? 'https://talisham.com/').replace(/\/$/, '');
const href = canonical ?? new URL(Astro.url.pathname, base + '/').href;
const ogImage = `${base}/og.png`;
const ld = graph(base, [organizationLd(base), websiteLd(base), ...schema]);
---

<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={href} />
    <link rel="alternate" hreflang="ar-SY" href={href} />
    <link rel="alternate" hreflang="x-default" href={href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#efece5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08110f" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ar_SY" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={href} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="تالي شام — متجر الهواتف الجوالة في سوريا" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="format-detection" content="telephone=no" />

    {/* رسمٌ واحد يعرّف المتجر والموقع وما تخصّ به هذه الصفحة */}
    <script type="application/ld+json" is:inline set:html={ld} />

    <!--
      سعر الصرف يُحقن هنا وقت الطلب من الحافة (الفصل 7 §7.11).
      الصفحة الساكنة تحمل الدولار، والليرة تُحسب في العميل —
      فلا يُعاد بناء آلاف الصفحات لتغيّر رقم واحد.

      وما هنا قيمةُ وقت البناء: احتياطٌ يعمل إن قُرئ الملف مباشرة أو
      عُطّل الحقن. والـWorker يستبدل محتوى هذا الوسم بالسعر الساري —
      ولذلك له مُعرِّف: بلا مِعلَمٍ يُميّزه لا سبيل إلى إيجاده في HTML.
    -->
    <script id="fx-boot" is:inline set:html={`window.__FX__=${JSON.stringify(fx)};`} />
  </head>

  <body>
    {demo && (
      <div class="sysbar sysbar--demo" role="status">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5" /><path d="M12 16h.01" /><circle cx="12" cy="12" r="9" /></svg>
        بيانات تجريبية — ليست منتجات حقيقية للبيع
      </div>
    )}

    <slot />

    <Footer />
    <BottomNav active={active} />

    <!--
      نص واحد صغير: تبديل العملة وحساب الليرة من سعر الصرف.
      المعادلة المرجعية مكرّرة هنا بالحد الأدنى لتجنّب تحميل حزمة كاملة
      في صفحة أصلها صفر JavaScript — وهي مطابقة لـ @talisham/ui/money.
    -->
    <script is:inline>
      (function () {
        var fx = window.__FX__ || { rate: 0 };
        var pref = localStorage.getItem('currency_pref') || 'SYP';

        function roundCash(s) { return Math.round(s / 10) * 10; }   // أصغر ورقة: 10 ل.س
        function fmtSyp(c) { return roundCash((c * fx.rate) / 100).toLocaleString('en-US') + ' ل.س'; }
        function fmtUsd(c) {
          return (c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' $';
        }

        function render() {
          document.querySelectorAll('[data-usd]').forEach(function (el) {
            var c = parseInt(el.getAttribute('data-usd'), 10);
            var alt = el.hasAttribute('data-alt');
            var showSyp = alt ? pref === 'USD' : pref === 'SYP';
            el.textContent = showSyp ? fmtSyp(c) : fmtUsd(c);
          });
          document.querySelectorAll('[data-cur-btn]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-cur-btn') === pref));
          });
        }

        document.addEventListener('click', function (e) {
          var b = e.target.closest('[data-cur-btn]');
          if (!b) return;
          pref = b.getAttribute('data-cur-btn');
          localStorage.setItem('currency_pref', pref);
          render();
        });

        render();
      })();
    </script>
  </body>
</html>
