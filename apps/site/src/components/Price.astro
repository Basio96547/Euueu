---
/**
 * السعر.
 * الرقم الذي يُدفع أولاً وأكبر، والعملة الأخرى مرجعٌ تحته، والسعر
 * القديم لا يُعرض مشطوباً وحده — يُعرض معه مقدار التوفير، فالشطب وحده
 * يُقرأ خطأً مطبعياً بينما «وفّر ٥٪» يُقرأ عرضاً.
 */
interface Props { usdCents: number; compareAt?: number | null; size?: 'sm' | 'md' | 'lg' }
const { usdCents, compareAt = null, size = 'sm' } = Astro.props;

const off = compareAt && compareAt > usdCents
  ? Math.round(((compareAt - usdCents) / compareAt) * 100)
  : 0;
---
<span class={`price price--${size}`}>
  <span class="price__main" data-usd={usdCents}></span>
  <span class="price__alt" data-usd={usdCents} data-alt></span>
  {compareAt && (
    <span class="price__was">
      <span class="price__old" data-usd={compareAt}></span>
      {off > 0 && <span class="price__save">وفّر {off}%</span>}
    </span>
  )}
</span>

<style>
  .price--sm .price__main { font-size: var(--step-0); }
  .price--md .price__main { font-size: var(--step-1); }
  .price--lg .price__main { font-size: clamp(1.45rem, 6.4vw, 2.1rem); line-height: 1.15; }
  .price--lg .price__alt { font-size: var(--step--1); }
</style>
