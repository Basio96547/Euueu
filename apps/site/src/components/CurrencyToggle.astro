---
// تبديل العملة: تحسين تدريجي — الأسعار مُصيَّرة من الخادم بالليرة أصلاً
---
<div class="curtoggle" role="group" aria-label="عملة العرض">
  <button type="button" data-cur-btn="SYP" aria-pressed="true">ل.س</button>
  <button type="button" data-cur-btn="USD" aria-pressed="false">$</button>
</div>

<style>
  .curtoggle {
    display: flex; padding: 2px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
  }
  .curtoggle button {
    font: inherit; font-size: var(--step--2); font-weight: var(--w-strong);
    border: 0; background: none; color: var(--ink-3);
    padding: 0 11px; border-radius: var(--r-pill); cursor: pointer;
    min-height: 30px; min-width: 34px;
    transition: background var(--dur-tap) var(--ease-state), color var(--dur-tap) var(--ease-state);
  }
  .curtoggle button[aria-pressed='true'] {
    background: var(--brass); color: var(--brass-ink);
    box-shadow: var(--sh-1);
  }
</style>
