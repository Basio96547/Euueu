---
/**
 * تذييل الموقع.
 * وجوده شرط جاهزية لا زينة: بندا 24 و25 يطلبان أن تكون سياسة الإرجاع
 * وشروط الاستخدام والخصوصية **منشورة وقابلة للوصول من كل صفحة** —
 * سياسةٌ لا يجدها الزبون كأنها غير منشورة.
 */
const groups: Array<{ h: string; links: Array<[string, string]> }> = [
  {
    h: 'المتجر',
    links: [
      ['/prices/', 'أسعار اليوم'],
      ['/c/smartphones/', 'هواتف ذكية'],
      ['/c/used-refurbished/', 'مستعمل ومجدَّد'],
      ['/c/power/', 'بطاريات وشواحن'],
      ['/compare/', 'المقارنة'],
    ],
  },
  {
    h: 'المساعدة',
    links: [
      ['/help/', 'مركز المساعدة'],
      ['/help/how-to-order/', 'كيف أطلب'],
      ['/help/check-imei/', 'التحقق من IMEI'],
      ['/blog/', 'المدونة'],
    ],
  },
  {
    h: 'السياسات',
    links: [
      ['/legal/return-policy/', 'الإرجاع والاستبدال'],
      ['/legal/warranty-policy/', 'شروط الكفالة'],
      ['/legal/terms/', 'شروط الاستخدام'],
      ['/legal/privacy/', 'الخصوصية'],
      ['/legal/account-deletion/', 'حذف الحساب'],
    ],
  },
];
---

<footer class="foot">
  <div class="inner">
    <div class="sig">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4.5 4.5h15v15h-15z" /><path d="M12 1.9 22.1 12 12 22.1 1.9 12z" /></svg>
      </span>
      <span class="wd">تالي <b>شام</b></span>
      <span class="loc">دمشق · سوريا</span>
    </div>

    <div class="cols">
      {groups.map((g) => (
        <nav aria-label={g.h}>
          <h2>{g.h}</h2>
          <ul>
            {g.links.map(([href, label]) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="pledge">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
        ><rect x="2.5" y="6" width="19" height="12" rx="2.2" /><circle cx="12" cy="12" r="2.6" /></svg>
      الدفع نقداً عند الاستلام حصراً — لا نطلب أي دفعة مقدَّمة بأي وسيلة.
    </p>
  </div>
</footer>

<style>
  .foot {
    /* أسفل كل صفحة ولا يُرى إلا في آخرها: لا يُرسم قبل الاقتراب منه */
    content-visibility: auto;
    contain-intrinsic-size: auto 520px;
    margin-block-start: var(--space-7);
    padding-block: var(--space-5) calc(var(--nav-h) + var(--safe-b) + 30px);
    border-block-start: 1px solid var(--line);
    background: var(--surface-2);
  }
  .inner {
    max-inline-size: var(--content); margin-inline: auto;
    padding-inline: var(--gutter);
    display: grid; gap: var(--space-5);
  }

  .sig { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .sig .mark { color: var(--brass); display: grid; place-items: center; }
  .sig .mark svg {
    inline-size: 20px; block-size: 20px;
    fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round;
  }
  .sig .wd { font-weight: 800; font-size: var(--step-1); }
  .sig .wd b { color: var(--brass); font-weight: 800; }
  .sig .loc {
    margin-inline-start: auto; font-size: var(--step--2); color: var(--ink-3); font-weight: 700;
  }

  .cols { display: grid; gap: var(--space-4); grid-template-columns: 1fr 1fr; }
  .foot h2 {
    font-size: var(--step--2); font-weight: 800; color: var(--ink-3);
    margin-block-end: 9px; letter-spacing: 0.03em;
  }
  .foot ul { display: grid; gap: 8px; }
  .foot a { font-size: var(--step--1); color: var(--ink-2); }
  .foot a:hover { color: var(--brass); }

  .pledge {
    display: flex; gap: 9px; align-items: flex-start;
    font-size: var(--step--1); color: var(--ink-2); line-height: 1.65;
    padding-block-start: var(--space-4); border-block-start: 1px solid var(--line);
  }
  .pledge .icon { color: var(--brass); flex: none; margin-block-start: 3px; }

  @media (min-width: 560px) { .cols { grid-template-columns: repeat(3, 1fr); } }
</style>
