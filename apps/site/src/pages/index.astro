---
/**
 * الصفحة الرئيسية.
 *
 * كانت تبدأ برقاقات الفئات ثم شبكةً من البطاقات مباشرة — أي فهرساً بلا
 * واجهة. والزبون الذي يفتح الرابط أول مرة لا يعرف من نحن ولا كيف يدفع
 * ولا لماذا يثق، والفهرس لا يجيب عن شيء من ذلك.
 *
 * الفاتحة تجيب عن الثلاثة في ارتفاع شاشةٍ واحدة: من نحن، وكيف تدفع،
 * وسعر الصرف الذي حُسبت به الأسعار — وهو في سوقٍ يتحرّك سعره يومياً
 * أهمّ ما يطمئن إليه المشتري.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, productsInCategory, brandList, currentFx } from '../lib/catalog';

const newest = products.filter((p) => p.category !== 'power' && p.category !== 'power-banks').slice(0, 4);
const power = productsInCategory('power');
const used = productsInCategory('used-refurbished');
/* سعر الصرف يُعرض كما هو: تقريبه إلى ألفٍ كان صحيحاً بالليرة القديمة،
   وصار يمحوه بعد حذف الصفرين (128.5 ← صفر). والكسر يُعرض إن وُجد. */
const syp = currentFx().rate.toLocaleString('en-US', { maximumFractionDigits: 2 });

const chips = [
  { slug: 'smartphones', label: 'هواتف ذكية' },
  { slug: 'used-refurbished', label: 'مستعمل ومجدَّد' },
  { slug: 'power-banks', label: 'بطاريات' },
  { slug: 'chargers', label: 'شواحن' },
  { slug: 'audio', label: 'سماعات' },
  { slug: 'wearables', label: 'ساعات' },
  { slug: 'protection', label: 'جرابات' },
];

const pillars = [
  {
    t: 'الدفع عند الاستلام',
    s: 'تفحص الجهاز بيدك ثم تدفع نقداً — بلا أي دفعة مقدَّمة',
    d: 'M2.5 6h19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-19a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z@M12 9.4a2.6 2.6 0 1 0 0 5.2 2.6 2.6 0 0 0 0-5.2',
  },
  {
    t: 'فحص IMEI موثَّق',
    s: 'نتيجة الفحص تُطبع على إيصالك وتُسلَّم مع الجهاز',
    d: 'M12 3l7.5 3v5.5c0 4.4-3 8.1-7.5 9.5-4.5-1.4-7.5-5.1-7.5-9.5V6z@m9 12 2.2 2.2L15.5 10',
  },
  {
    t: 'كفالة مكتوبة',
    s: 'مدّتها مكتوبة على صفحة الجهاز وفي الإيصال — لا وعدٌ شفهيّ',
    d: 'M6 3h12a2 2 0 0 1 2 2v16l-8-4-8 4V5a2 2 0 0 1 2-2z',
  },
];
---

<Base title="جوالات وملحقات" active="home">
  <Header />

  <main class="container">
    {/*
      الطيّة عمودان على الشاشة الواسعة لا عمودٌ واحد ملتصقٌ باليمين.

      كان نصفُ الشاشة الأيسر فارغاً تماماً في البطل — المحتوى كلّه محصورٌ
      في 34rem على اليمين، والباقي بياضٌ لا يحمل شيئاً. وذلك ليس «مساحةً
      سالبة» بل تخطيطُ هاتفٍ مُدَّ على حاسوب.

      فصارت أعمدةُ الثقة الثلاثة تشغل النصف الثاني بدل أن تنزل تحته:
      يرى الزائر ما نبيع **ولماذا يثق** في طيّةٍ واحدة، وهو ترتيبُ
      الإقناع الصحيح في متجرٍ يُدفع فيه نقداً عند الباب.
    */}
    <div class="fold">
    <section class="hero">
      <p class="eyebrow">دمشق · توصيل خلال 24–48 ساعة</p>
      <h1>جهازك الجديد يصل إليك،<br />وتدفع بعد أن تفحصه.</h1>
      <p class="lede">
        هواتف جديدة ومستعملة مفحوصة، وبطاريات وشواحن لانقطاع الكهرباء —
        بأسعارٍ تُحدَّث يومياً على سعر الصرف.
      </p>

      <div class="cta">
        <a class="btn" href="/c/smartphones/">تصفّح الهواتف</a>
        <a class="btn btn--quiet" href="/c/used-refurbished/">مستعمل بكفالة</a>
      </div>

      <p class="fx tnum">
        <span class="dot" aria-hidden="true"></span>
        <span>سعر اليوم: <b>1 دولار = {syp} ل.س</b></span>
        <a href="/prices/">جدول الأسعار</a>
      </p>
    </section>

    <ul class="pillars">
      {pillars.map((p) => (
        <li>
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            {p.d.split('@').map((d) => <path d={d} />)}
          </svg>
          <div><b>{p.t}</b><span>{p.s}</span></div>
        </li>
      ))}
    </ul>
    </div>

    <nav class="chip-row" aria-label="الفئات">
      {chips.map((c) => <a class="chip" href={`/c/${c.slug}/`}>{c.label}</a>)}
    </nav>

    <section class="sec">
      <div class="sec-h">
        <div>
          <p class="eyebrow">وصل حديثاً</p>
          <h2>أحدث ما دخل المحل</h2>
        </div>
        <a class="more" href="/c/smartphones/">الكل
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
        </a>
      </div>
      <div class="card-grid">{newest.map((p) => <ProductCard product={p} />)}</div>
    </section>

    <section class="sec">
      <div class="sec-h">
        <div>
          <p class="eyebrow">لانقطاع الكهرباء</p>
          <h2>بطاريات وشواحن</h2>
        </div>
        <a class="more" href="/c/power/">الكل
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
        </a>
      </div>
      <p class="sec-note">من أعلى الفئات دوراناً بعد الجوالات — بطاريات محمولة وشواحن شمسية.</p>
      <div class="card-grid">{power.slice(0, 4).map((p) => <ProductCard product={p} />)}</div>
    </section>

    <section class="sec">
      <div class="sec-h">
        <div>
          <p class="eyebrow">مفحوص قطعةً قطعة</p>
          <h2>مستعمل ومجدَّد بكفالة</h2>
        </div>
        <a class="more" href="/c/used-refurbished/">الكل
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
        </a>
      </div>
      <p class="sec-note">لكل جهاز نسبة صحة بطاريته ونتيجة فحص IMEI الخاصة به — مكتوبةً على صفحته.</p>
      <div class="card-grid">{used.slice(0, 4).map((p) => <ProductCard product={p} />)}</div>
    </section>

    <section class="sec">
      <div class="sec-h"><h2>العلامات</h2></div>
      <div class="brands">
        {brandList.map((b) => (
          <a class="brand-tile" href={`/b/${b.slug}/`}>
            <span class="lat">{b.name.en ?? b.name.ar}</span>
            <span class="ar">{b.name.ar}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="sec">
      <a class="ask" href="/help/">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M21 12a9 9 0 1 1-3.4-7" /><path d="M9.6 9.2a2.6 2.6 0 1 1 3.4 2.5c-.7.3-1 .9-1 1.6v.4" /><path d="M12 17.4h.01" /></svg>
        <div>
          <b>لست متأكداً أيّ جهاز يناسبك؟</b>
          <span>مركز المساعدة يشرح الفرق بين النسخ والمصادر والكفالات.</span>
        </div>
        <svg class="icon go" viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
      </a>
    </section>
  </main>
</Base>

<style>
  /* ————— الفاتحة ————— */
  .fold { display: grid; gap: 0; }
  .hero { display: grid; gap: 12px; padding-block: 22px 6px; max-inline-size: 34rem; }
  .hero h1 { font-size: var(--step-3); line-height: 1.22; }
  .lede { font-size: var(--step-0); color: var(--ink-2); line-height: 1.7; }
  .cta { display: flex; gap: 9px; flex-wrap: wrap; margin-block-start: 4px; }
  .cta .btn { flex: 1 1 auto; min-inline-size: 9.5rem; }

  .fx {
    display: flex; align-items: center; gap: 8px;
    font-size: var(--step--1); color: var(--ink-2);
    padding: 9px 12px; margin-block-start: 6px;
    border-radius: var(--r-s);
    background: color-mix(in srgb, var(--jade) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--jade) 24%, transparent);
  }
  .fx b { color: var(--ink); white-space: nowrap; }
  .fx a { color: var(--jade); font-weight: var(--w-strong); margin-inline-start: auto; white-space: nowrap; }
  .fx .dot {
    inline-size: 7px; block-size: 7px; border-radius: 50%; flex: none;
    background: var(--jade); box-shadow: 0 0 0 3px color-mix(in srgb, var(--jade) 22%, transparent);
  }

  /* ————— الأعمدة الثلاثة ————— */
  .pillars {
    display: grid; margin-block-start: 18px;
    border: 1px solid var(--line); border-radius: var(--r-l);
    background: var(--surface); overflow: hidden;
  }
  .pillars li {
    display: flex; gap: 11px; align-items: flex-start; padding: 12px 13px;
    border-block-end: 1px solid var(--line-2);
  }
  .pillars li:last-child { border-block-end: 0; }
  .pillars .icon { color: var(--brass); margin-block-start: 3px; }
  .pillars b { display: block; font-size: var(--step--1); line-height: 1.5; }
  .pillars span { font-size: var(--step--2); color: var(--ink-2); line-height: 1.6; }

  .chip-row { margin-block-start: 20px; }

  /* ————— العلامات ————— */
  .brands { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .brand-tile {
    display: grid; gap: 1px; place-items: center; text-align: center;
    padding: 12px 4px; border-radius: var(--r-m);
    background: var(--surface); border: 1px solid var(--line);
  }
  .brand-tile .lat {
    font-family: var(--font-mono); font-size: 0.62rem; font-weight: var(--w-strong);
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--brass);
  }
  .brand-tile .ar { font-size: var(--step--2); color: var(--ink-2); font-weight: var(--w-strong); }

  /* ————— لافتة المساعدة ————— */
  .ask {
    display: flex; gap: 11px; align-items: center; padding: 14px;
    border-radius: var(--r-l); background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .ask > .icon { color: var(--brass); flex: none; }
  .ask b { display: block; font-size: var(--step--1); line-height: 1.5; }
  .ask span { font-size: var(--step--2); color: var(--ink-2); line-height: 1.6; }
  .ask .go { color: var(--ink-3); margin-inline-start: auto; }

  @media (min-width: 560px) {
    .hero { padding-block: 34px 10px; }
    .cta .btn { flex: 0 0 auto; }
    .pillars { grid-template-columns: repeat(3, 1fr); }
    .pillars li { border-block-end: 0; border-inline-end: 1px solid var(--line-2); flex-direction: column; }
    .pillars li:last-child { border-inline-end: 0; }
  }

  /* الطيّة عمودان من 900px: النصّ يمينُ القراءة، وأعمدةُ الثقة تملأ
     النصف الذي كان فارغاً. ودونها يبقى الترتيب رأسياً كما هو. */
  @media (min-width: 900px) {
    .fold {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-7);
      align-items: center;
      padding-block: 8px 26px;
    }
    .hero { padding-block: 0; max-inline-size: none; }
    .pillars {
      margin-block-start: 0;
      grid-template-columns: 1fr;
    }
    .pillars li {
      border-inline-end: 0;
      border-block-end: 1px solid var(--line-2);
      flex-direction: row;
      padding: 15px 16px;
    }
    .pillars li:last-child { border-block-end: 0; }
  }
</style>
