---
/**
 * صفحة العلامة التجارية (الفصل 12 §12.1).
 * «ايفون في سوريا» و«سامسونج دمشق» استعلامات تصفّحية لها صفحة تستحقها،
 * وبلا هذه الصفحة تتنافس صفحات المنتجات على الكلمة نفسها وتخسرها جميعاً.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import { brandList, productsOfBrand, categories } from '../../lib/catalog';
import { breadcrumbLd, itemListLd } from '../../lib/seo';

export function getStaticPaths() {
  return brandList.map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
const items = productsOfBrand(brand.slug);
const catName = new Map(categories.map((c) => [c.slug, c.name.ar]));

const inCats = [...new Set(items.map((p) => p.category))];
const cheapest = items.length
  ? Math.min(...items.map((p) => Math.min(...p.variants.map((v) => v.priceUsdCents))))
  : 0;

const base = (Astro.site?.href ?? 'https://talisham.com/').replace(/\/$/, '');
const schema = [
  {
    '@type': 'CollectionPage',
    name: `${brand.name.ar} في سوريا`,
    about: { '@type': 'Brand', name: brand.name.en ?? brand.name.ar },
    numberOfItems: items.length,
  },
  breadcrumbLd(base, [['الرئيسية', '/'], [brand.name.ar, `/b/${brand.slug}/`]]),
  itemListLd(base, items.map((p) => ({
    slug: p.slug, name: p.name.ar,
    usdCents: p.variants[0]!.priceUsdCents, inStock: p.variants[0]!.stock > 0,
  }))),
];
---

<Base
  title={`${brand.name.ar} في سوريا`}
  description={`أجهزة وملحقات ${brand.name.ar} بأسعار محدَّثة ودفع عند الاستلام — تالي شام`}
  active="search"
  schema={schema}
>
  <Header title={brand.name.ar} back="/" active="search" />

  <main class="container">
    <div class="pagehead">
      {brand.name.en && <p class="eyebrow">{brand.name.en}</p>}
      <h1>{brand.name.ar} في سوريا</h1>
      <p class="lede">
        {items.length} منتجاً من {brand.name.ar} متوفر الآن، دفعٌ عند الاستلام بعد
        معاينة الجهاز، وكفالةٌ مكتوبة على كل قطعة.
      </p>
      {cheapest > 0 && (
        <p class="from tnum">يبدأ من <b data-usd={cheapest}></b></p>
      )}
    </div>

    {items.length === 0 ? (
      <p class="empty">لا منتجات من هذه العلامة حالياً.</p>
    ) : (
      <div class="card-grid">{items.map((p) => <ProductCard product={p} />)}</div>
    )}

    {inCats.length > 0 && (
      <nav class="links" aria-label="فئات ذات صلة">
        {inCats.map((c) => <a class="chip" href={`/c/${c}/`}>{catName.get(c) ?? c}</a>)}
      </nav>
    )}
  </main>
</Base>

<style>
  .container { display: grid; gap: 14px; }
  .from { font-size: var(--step--1); font-weight: var(--w-strong); color: var(--ink-3); }
  .from b { color: var(--brass); font-weight: var(--w-strong); }
  .empty { padding: 40px 0; text-align: center; color: var(--ink-3); }
  .links { display: flex; gap: 6px; flex-wrap: wrap; }
  .links { margin-block: 4px; }
</style>
