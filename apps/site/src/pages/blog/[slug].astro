---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { POSTS } from '../../lib/blog';
import { jsonForScript } from '../../lib/seo';

export function getStaticPaths() {
  return POSTS.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.summary,
  datePublished: post.published,
  inLanguage: 'ar',
  publisher: { '@type': 'Organization', name: 'تالي شام' },
};
---

<Base title={post.title} description={post.summary}>
  <Header title="المدونة" back="/blog/" />

  <article class="wrap">
    <h1>{post.title}</h1>
    <p class="meta tnum">{post.published} · {post.readMinutes} دقائق قراءة</p>
    <p class="lead">{post.summary}</p>

    {post.blocks.map((b) => (
      <section class="blk">
        {b.h && <h2>{b.h}</h2>}
        {b.p.map((t) => <p>{t}</p>)}
      </section>
    ))}

    <div class="tags">
      {post.tags.map((t) => <span class="tag">{t}</span>)}
    </div>

    <nav class="links" aria-label="روابط ذات صلة">
      {post.related.map((r) => <a href={r.href}>{r.label}</a>)}
    </nav>
  </article>

  <script type="application/ld+json" is:inline set:html={jsonForScript(ld)} />
</Base>

<style>
  .wrap { padding: 12px 12px 96px; display: grid; gap: 10px; }
  h1 { font-size: var(--step-1); font-weight: var(--w-strong); line-height: 1.5; }
  .meta { font-size: var(--step--1); color: var(--ink-3); }
  .lead { color: var(--ink-2); line-height: 1.8; font-weight: var(--w-strong); }
  .blk { display: grid; gap: 7px; margin-block-start: 8px; }
  .blk h2 { font-size: var(--step-0); font-weight: var(--w-strong); }
  .blk p { color: var(--ink-2); line-height: 1.9; font-size: var(--step--1); }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; margin-block-start: 8px; }
  .links { display: flex; gap: 6px; flex-wrap: wrap; margin-block-start: 4px; }
  .links a {
    font-size: var(--step--1); font-weight: var(--w-strong); color: var(--ink-2);
    background: var(--surface); border: 1px solid var(--line);
    border-radius: 999px; padding: 7px 14px; text-decoration: none;
  }
</style>
