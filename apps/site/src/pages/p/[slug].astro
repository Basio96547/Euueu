---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import ProductCard from '../../components/ProductCard.astro';
import Price from '../../components/Price.astro';
import ProductMedia from '../../components/ProductMedia.astro';
import {
  products, categories, compatibleAccessories, currentFx, reviewsFor, questionsFor,
  CONDITION_AR, ORIGIN_AR, WARRANTY_AR,
} from '../../lib/catalog';
import { breadcrumbLd } from '../../lib/seo';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const v = product.variants[0]!;
const fx = currentFx();
const accessories = compatibleAccessories(product.slug);
const catName = categories.find((c) => c.slug === product.category)?.name.ar ?? 'الكتالوج';
const availLabel =
  v.stock === 0 ? 'نفد المخزون'
  : v.stock === 1 ? 'آخر قطعة'
  : v.stock === 2 ? 'آخر قطعتين'
  : 'متوفّر الآن';

/* تُجلب وقت البناء وتُدرَج في HTML: لا استدعاء شبكة عند الزائر،
   وتقرؤها محركات البحث كما يقرؤها الإنسان. */
const [reviews, questions] = await Promise.all([
  reviewsFor(product.slug),
  questionsFor(product.slug),
]);
const stars = (n: number) => '★'.repeat(n) + '☆'.repeat(5 - n);
const specRows: Array<[string, string]> = [
  ['الحالة', CONDITION_AR[v.condition]],
  ['المصدر', ORIGIN_AR[v.deviceOrigin]],
  ...(v.partCode ? [['رمز النسخة', v.partCode] as [string, string]] : []),
  ['الكفالة', `${WARRANTY_AR[v.warrantyType]} · ${v.warrantyMonths} شهراً`],
  ...(v.batteryHealthPct ? [['صحة البطارية', `${v.batteryHealthPct}%`] as [string, string]] : []),
  ...(v.storageGb ? [['الذاكرة', `${v.storageGb} جيجابايت`] as [string, string]] : []),
  ...(product.spec.screen_size_in ? [['الشاشة', `${product.spec.screen_size_in} بوصة`] as [string, string]] : []),
  ...(product.spec.chipset ? [['المعالج', String(product.spec.chipset)] as [string, string]] : []),
  ...(product.spec.battery_mah ? [['البطارية', `${product.spec.battery_mah} مللي أمبير`] as [string, string]] : []),
  ['الشحن', 'دمشق خلال 24–48 ساعة'],
];

/* البيانات المنظمة بالدولار — وهي العملة المرجعية.
   صلاحية قصيرة لأن سعر الصرف يتحرك (الفصل 12 §12.1). */
const base = (Astro.site?.href ?? 'https://talisham.com/').replace(/\/$/, '');
const productLd = {
  '@type': 'Product',
  name: product.name.ar,
  description: product.shortDesc?.ar ?? undefined,
  brand: { '@type': 'Brand', name: product.brandName.ar },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: (v.priceUsdCents / 100).toFixed(2),
    priceValidUntil: fx.validUntil.slice(0, 10),
    availability: v.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
    itemCondition:
      v.condition === 'NEW' ? 'https://schema.org/NewCondition'
      : v.condition === 'REFURBISHED' ? 'https://schema.org/RefurbishedCondition'
      : 'https://schema.org/UsedCondition',
    seller: { '@id': `${base}/#store` },
  },
  ...(reviews.count > 0
    ? { aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: reviews.average.toFixed(1),
          reviewCount: reviews.count,
        } }
    : {}),
};

/* الفتات يحلّ محلّ الرابط تحت العنوان في نتيجة البحث */
const schema = [
  productLd,
  breadcrumbLd(base, [
    ['الرئيسية', '/'],
    [catName, `/c/${product.category}/`],
    [product.name.ar, `/p/${product.slug}/`],
  ]),
];
---

<Base
  title={`${product.name.ar}${v.storageGb ? ` ${v.storageGb} جيجابايت` : ''}`}
  description={product.shortDesc?.ar ?? `${product.name.ar} في سوريا — ${CONDITION_AR[v.condition]}، ${ORIGIN_AR[v.deviceOrigin]}، دفع عند الاستلام`}
  active="home"
  schema={schema}
>
  <Header title={product.name.ar} back={`/c/${product.category}`} />

  <main class="container pdp">
    <nav class="crumbs" aria-label="مسار التصفّح">
      <a href="/">الرئيسية</a><span aria-hidden="true">/</span>
      <a href={`/c/${product.category}/`}>{catName}</a><span aria-hidden="true">/</span>
      <a href={`/b/${product.brand}/`}>{product.brandName.ar}</a>
    </nav>

    <ProductMedia
      brand={product.brand}
      brandName={product.brandName.en ?? product.brandName.ar}
      category={product.category}
      name={product.name.ar}
      colorCode={v.colorCode}
      ratio="1 / 1"
      alt={product.name.ar}
      class="pm--hero"
    >
      <span class="mnote">رسمٌ توضيحيّ</span>
    </ProductMedia>

    <div class="buy">
    <div class="head">
      <p class="brandline">{product.brandName.ar}{v.colorName ? ` · ${v.colorName.ar}` : ''}</p>
      <h1>{product.name.ar}{v.storageGb ? ` ${v.storageGb} جيجابايت` : ''}</h1>
      {product.shortDesc?.ar && <p class="lede">{product.shortDesc.ar}</p>}
    </div>

    <div class="pricebox">
      <span class:list={['avail', v.stock === 0 && 'avail--out']}>{availLabel}</span>
      <Price usdCents={v.priceUsdCents} compareAt={v.compareAtPriceUsdCents} size="lg" />
    </div>

    <div class="badges">
      <span class="tag tag--brass" data-v-part hidden={!v.partCode}>{v.partCode ? `${v.partCode} · ${ORIGIN_AR[v.deviceOrigin]}` : ''}</span>
      <span class:list={['tag', v.esimOnly && 'tag--clay']} data-v-sim hidden={!v.dualSim && !v.esimOnly}>
        {v.esimOnly ? 'eSIM فقط — بلا منفذ شريحة' : v.dualSim ? 'شريحتان فعليتان' : ''}
      </span>
      <span class="tag tag--jade" data-v-warranty hidden={v.warrantyMonths === 0}>
        {v.warrantyMonths > 0 ? `${WARRANTY_AR[v.warrantyType]} ${v.warrantyMonths} شهراً` : ''}
      </span>
      {product.spec.network_gen && <span class="tag">{product.spec.network_gen}</span>}
    </div>

    {v.condition !== 'NEW' && (
      <div class="verify">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3l7.5 3v5.5c0 4.4-3 8.1-7.5 9.5-4.5-1.4-7.5-5.1-7.5-9.5V6z" /><path d="m9 12 2.2 2.2L15.5 10" />
        </svg>
        <div>
          <b>فحص IMEI: مطابق ونظيف</b>
          <span>الرقم غير مبلَّغ عنه، ويُسلَّم لك مطبوعاً على الإيصال مع الجهاز.</span>
        </div>
      </div>
    )}

    {product.variants.length > 1 && (
      <div class="picker">
        <span class="picker-h">النسخة والمصدر</span>
        <div class="opts">
          {product.variants.map((x, i) => (
            <button class="opt" type="button" aria-pressed={i === 0}
              data-usd-opt={x.priceUsdCents} data-sku={x.sku} data-stock={x.stock}
              data-old={x.compareAtPriceUsdCents ?? ''}
              data-part={x.partCode ? `${x.partCode} · ${ORIGIN_AR[x.deviceOrigin]}` : ORIGIN_AR[x.deviceOrigin]}
              data-sim={x.esimOnly ? 'eSIM فقط — بلا منفذ شريحة' : x.dualSim ? 'شريحتان فعليتان' : ''}
              data-sim-kind={x.esimOnly ? 'clay' : ''}
              data-warranty={x.warrantyMonths > 0 ? `${WARRANTY_AR[x.warrantyType]} ${x.warrantyMonths} شهراً` : ''}
              data-avail={x.stock === 0 ? 'نفد المخزون' : x.stock <= 2 ? `آخر ${x.stock === 1 ? 'قطعة' : 'قطعتين'}` : 'متوفر'}
              data-color={x.colorName?.ar ?? ''}>
              {x.partCode ?? ORIGIN_AR[x.deviceOrigin]}
              <small>
                {x.esimOnly ? 'eSIM فقط' : x.dualSim ? 'شريحتان' : '—'} ·
                {x.stock > 0 ? ` متوفر ${x.stock}` : ' نفد'}
              </small>
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="cod">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="2.2" /><circle cx="12" cy="12" r="2.6" /></svg>
      الدفع نقداً عند الاستلام — تفحص الجهاز قبل أن تدفع
    </div>

    {/* شريط الشراء: عائمٌ ملتصقٌ بالأسفل على الهاتف، وجزءٌ من لوحة الشراء
        على الشاشة الواسعة — عنصرٌ واحد بسلوكين لا نسختان في الصفحة. */}
    <div class="buybar glass">
      <span class="pr">
        <b data-usd={v.priceUsdCents}></b>
        <small data-usd={v.priceUsdCents} data-alt></small>
      </span>
      <a class="btn btn--icon" href="https://wa.me/963993223887" aria-label="تواصل عبر واتساب">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-3.2-6.4" /><path d="M4 20l1.4-3.6" /></svg>
      </a>
      <button class="btn btn--buy" type="button" data-add data-sku={v.sku}
        disabled={v.stock === 0} aria-live="polite">
        {v.stock === 0 ? 'نفد المخزون' : 'أضف للسلة'}
      </button>
    </div>

    {/* رسالة النتيجة تُقرأ بالصوت أيضاً: من لا يرى الزرّ يتبدّل يسمع ما جرى */}
    <p class="addmsg" data-add-msg role="status" hidden></p>

    <div class="cmpbar">
      <button class="btn btn--ghost" type="button" data-cmp={product.slug} aria-pressed="false">
        أضف إلى المقارنة
      </button>
      <a class="cmplink" href="/compare/" hidden data-cmp-link>افتح المقارنة (<span data-cmp-n>0</span>)</a>
    </div>
    </div>

    <dl class="facts">
      {specRows.map(([k, val]) => (
        <div class="fact"><dt>{k}</dt><dd class="tnum">{val}</dd></div>
      ))}
    </dl>

    {reviews.count > 0 && (
      <section class="also">
        <h2>آراء من اشتروه</h2>
        <div class="rsum">
          <span class="ravg tnum">{reviews.average.toFixed(1)}</span>
          <span class="rstars" aria-label={`${reviews.average} من 5`}>{stars(Math.round(reviews.average))}</span>
          <span class="muted">{reviews.count} مراجعة</span>
        </div>
        <div class="rbars">
          {[5, 4, 3, 2, 1].map((n) => (
            <div class="rbar">
              <span class="tnum">{n}</span>
              <span class="track">
                <span class="fill" style={`inline-size:${reviews.count ? (reviews.distribution[String(n)] ?? 0) / reviews.count * 100 : 0}%`}></span>
              </span>
              <span class="tnum muted">{reviews.distribution[String(n)] ?? 0}</span>
            </div>
          ))}
        </div>
        {reviews.items.slice(0, 8).map((r) => (
          <article class="rev">
            <div class="rhead">
              <span class="rstars">{stars(r.rating)}</span>
              <span class="muted">{r.author}</span>
            </div>
            {r.title && <b>{r.title}</b>}
            {r.body && <p>{r.body}</p>}
            {r.merchantReply && (
              <p class="reply"><b>رد تالي شام:</b> {r.merchantReply}</p>
            )}
          </article>
        ))}
      </section>
    )}

    {questions.length > 0 && (
      <section class="also">
        <h2>أسئلة عن هذا الجهاز</h2>
        {questions.slice(0, 10).map((q) => (
          <article class="rev">
            <b>{q.body}</b>
            {q.answer && <p>{q.answer}</p>}
          </article>
        ))}
      </section>
    )}

    {accessories.length > 0 && (
      <section class="also">
        <h2>ملحقات متوافقة</h2>
        <div class="card-grid">{accessories.map((a) => <ProductCard product={a} />)}</div>
      </section>
    )}
  </main>

  <script is:inline>
    // جزيرة صغيرة: تبديل المتغيّر يغيّر السعر والوسوم (الفصل 5 §5.2)
    (function () {
      var opts = document.querySelectorAll('[data-usd-opt]');
      if (!opts.length) return;
      opts.forEach(function (btn) {
        btn.addEventListener('click', function () {
          opts.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)); });
          /* الزرّ يشتري النسخة المختارة لا الأولى: بلا هذا يدفع الزبون
             ثمن ما اختار ويستلم ما لم يختره. */
          var add = document.querySelector('[data-add]');
          if (add) {
            add.setAttribute('data-sku', btn.getAttribute('data-sku') || '');
            var st = parseInt(btn.getAttribute('data-stock') || '0', 10);
            add.disabled = st <= 0;
            add.textContent = st > 0 ? 'أضف للسلة' : 'نفد المخزون';
          }
          var usd = btn.getAttribute('data-usd-opt');
          var old = btn.getAttribute('data-old') || '';
          var g = function (k) { return btn.getAttribute(k) || ''; };

          var priced = document.querySelectorAll('.price__main, .price__alt, .buybar [data-usd]');
          priced.forEach(function (el) { el.classList.add('is-fading'); });

          setTimeout(function () {
            priced.forEach(function (el) {
              el.setAttribute('data-usd', usd);
              el.classList.remove('is-fading');
            });

            /* السعر القديم وشارة التوفير يخصّان نسخةً بعينها. وتركُهما من
               النسخة السابقة يخترع خصماً لا وجود له — وهو أسوأ من إخفائه. */
            var wasEl = document.querySelector('.price__was');
            var oldEl = document.querySelector('.price__old');
            var saveEl = document.querySelector('.price__save');
            if (wasEl) wasEl.hidden = !(old && Number(old) > Number(usd));
            if (oldEl) {
              if (old && Number(old) > Number(usd)) {
                oldEl.setAttribute('data-usd', old);
                oldEl.hidden = false;
                if (saveEl) {
                  saveEl.textContent = 'وفّر ' + Math.round((1 - usd / old) * 100) + '%';
                  saveEl.hidden = false;
                }
              } else {
                oldEl.hidden = true;
                if (saveEl) saveEl.hidden = true;
              }
            }

            /* الوصفُ يتبع النسخة أيضاً: «شريحتان فعليتان» على نسخةٍ بلا
               منفذ شريحة كذبةٌ يكتشفها الزبون عند الباب، وهي أوّل ما يسأل
               عنه المشتري هنا قبل السعر. */
            var setTag = function (sel, text, clay) {
              var el = document.querySelector(sel);
              if (!el) return;
              el.textContent = text;
              el.hidden = !text;
              if (clay !== undefined) el.classList.toggle('tag--clay', !!clay);
            };
            setTag('[data-v-part]', g('data-part'));
            setTag('[data-v-sim]', g('data-sim'), g('data-sim-kind') === 'clay');
            setTag('[data-v-warranty]', g('data-warranty'));

            var av = document.querySelector('.avail');
            if (av) {
              av.textContent = g('data-avail');
              av.classList.toggle('avail--out', g('data-avail') === 'نفد المخزون');
            }
            var bl = document.querySelector('.brandline');
            var col = g('data-color');
            if (bl && col) bl.textContent = bl.textContent.split(' · ')[0] + ' · ' + col;

            // بابٌ صريح لا نقرةٌ مصطنعة: تلك كانت تسقط بـTypeError فلا يُصيَّر شيء
            document.dispatchEvent(new Event('prices:render'));
          }, 140);
        });
      });
    })();


    /*
      الإضافة إلى السلة.

      هذا كان الثقب الذي يُفرغ كل ما قبله من معنى: الواجهة البرمجية
      تُضيف إلى السلة وتُختبر، وزرُّ «أضف للسلة» بلا مستمعٍ واحد — فالمتجر
      كلّه لا يستطيع استقبال طلب. والاختبارات كانت تنادي المسار مباشرةً
      فتمرّ، وهو بالضبط ما يُخفيه اختبارٌ لا يمرّ من حيث يمرّ الزبون.

      والسلة على الأصل نفسه الذي عليه ‎/app‎، فرمزها في `localStorage`
      مشتركٌ بينهما: يُنشأ هنا ويقرؤه التطبيق كما هو.

      والقراءة قبل الكتابة مقصودة: مسار الخادم يضبط الكمية ضبطاً لا
      زيادة، فضغطتان تتركان واحدة. نقرأ الكمية القائمة ونضيف إليها.
    */
    (function () {
      var btn = document.querySelector('[data-add]');
      var msg = document.querySelector('[data-add-msg]');
      if (!btn) return;
      var API = '/api/v1';
      var busy = false;

      function say(text, kind) {
        if (!msg) return;
        msg.textContent = text;
        msg.hidden = false;
        msg.setAttribute('data-kind', kind);
      }

      async function jsonOf(res) {
        try { return await res.json(); } catch (e) { return null; }
      }

      /* رسالة الخادم بالعربية تُعرض كما هي: هو وحده يعرف السبب —
         نفد المخزون؟ سعر تبدّل؟ سعر صرف متقادم؟ */
      function reasonOf(body, fallback) {
        var m = body && body.error && body.error.message;
        return (m && (m.ar || m.en)) || fallback;
      }

      async function cartToken() {
        var t = localStorage.getItem('cart_token');
        if (t) return t;
        var res = await fetch(API + '/carts', { method: 'POST' });
        var body = await jsonOf(res);
        if (!res.ok || !body || !body.data) throw new Error(reasonOf(body, 'تعذّر إنشاء السلة'));
        localStorage.setItem('cart_token', body.data.cartToken);
        return body.data.cartToken;
      }

      function badge(n) {
        try { localStorage.setItem('cart_count', String(n)); } catch (e) {}
        document.dispatchEvent(new CustomEvent('cart:count', { detail: n }));
      }

      btn.addEventListener('click', async function () {
        if (busy || btn.disabled) return;
        var sku = btn.getAttribute('data-sku');
        if (!sku) return;

        busy = true;
        var label = btn.textContent;
        btn.setAttribute('data-busy', '');
        btn.textContent = 'جارٍ الإضافة…';
        if (msg) msg.hidden = true;

        try {
          var token = await cartToken();

          var cur = await fetch(API + '/carts/' + token);
          var curBody = await jsonOf(cur);
          /* رمزٌ لسلّةٍ مسحها الخادم: يُنسى ويُنشأ غيره بدل أن يفشل الزبون */
          if (cur.status === 404) {
            localStorage.removeItem('cart_token');
            token = await cartToken();
            curBody = null;
          }
          var lines = (curBody && curBody.data && curBody.data.lines) || [];
          var qty = 1;
          for (var i = 0; i < lines.length; i++) {
            if (lines[i].sku === sku) { qty = (lines[i].qty || 0) + 1; break; }
          }

          var res = await fetch(API + '/carts/' + token + '/items', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ sku: sku, qty: qty }),
          });
          var body = await jsonOf(res);
          if (!res.ok) throw new Error(reasonOf(body, 'تعذّرت الإضافة'));

          var all = (body.data && body.data.lines) || [];
          var count = all.reduce(function (a, l) { return a + (l.qty || 0); }, 0);
          badge(count);

          btn.textContent = 'أُضيف ✓';
          say('في سلتك الآن — الدفع عند الاستلام.', 'ok');
          /* النجاح يزول وحده، والخطأ يبقى: من فشلت إضافته يحتاج أن يقرأ لماذا */
          setTimeout(function () {
            btn.textContent = label;
            if (msg && msg.getAttribute('data-kind') === 'ok') msg.hidden = true;
          }, 2600);
        } catch (e) {
          btn.textContent = label;
          say((e && e.message) || 'تعذّرت الإضافة — أعد المحاولة', 'err');
        } finally {
          busy = false;
          btn.removeAttribute('data-busy');
        }
      });
    })();

    // المقارنة: قائمة في تخزين المتصفح تقرأها /compare — بلا حساب ولا شبكة
    (function () {
      var btn = document.querySelector('[data-cmp]');
      var link = document.querySelector('[data-cmp-link]');
      var n = document.querySelector('[data-cmp-n]');
      if (!btn) return;
      var slug = btn.getAttribute('data-cmp');

      function list() {
        try { return JSON.parse(localStorage.getItem('compare') || '[]'); } catch (e) { return []; }
      }
      function render() {
        var l = list();
        var on = l.indexOf(slug) !== -1;
        btn.setAttribute('aria-pressed', String(on));
        btn.textContent = on ? 'في المقارنة ✓' : 'أضف إلى المقارنة';
        link.hidden = l.length === 0;
        link.href = '/compare?p=' + l.join(',');
        n.textContent = String(l.length);
      }
      btn.addEventListener('click', function () {
        var l = list();
        var i = l.indexOf(slug);
        if (i !== -1) l.splice(i, 1);
        else if (l.length >= 4) { alert('أربعة أجهزة كحدّ أقصى في المقارنة.'); return; }
        else l.push(slug);
        localStorage.setItem('compare', JSON.stringify(l));
        render();
      });
      render();
    })();
  </script>
</Base>

<style>
  .pdp { padding-block: 6px 0; display: grid; gap: 14px; }
  .buy { display: grid; gap: 14px; align-content: start; }
  /* الشريطان السفليّان معاً: شريط الشراء ثم شريط التنقّل تحته */
  :global(body) { padding-block-end: calc(var(--nav-h) + var(--safe-b) + 88px); }

  .crumbs {
    display: flex; gap: 7px; align-items: center; flex-wrap: wrap;
    font-size: var(--step--2); color: var(--ink-3); padding-block-start: 6px;
  }
  .crumbs a { color: var(--ink-3); }
  .crumbs a:last-child { color: var(--brass); font-weight: var(--w-strong); }

  .pdp :global(.pm--hero) {
    --pm-scale: 0.76;
    border-radius: var(--r-xl);
    border: 1px solid var(--line);
    max-inline-size: 520px; inline-size: 100%; margin-inline: auto;
  }
  .mnote {
    position: absolute; inset-block-end: 8px; inset-inline-end: 10px;
    font-size: var(--step--2); color: var(--ink-3);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border-radius: var(--r-pill); padding: 2px 9px;
  }

  .head { display: grid; gap: 5px; }
  .brandline {
    font-size: var(--step--1); font-weight: var(--w-strong); color: var(--brass);
  }
  .pdp h1 { font-size: var(--step-2); line-height: var(--lh-tight); }
  .lede { font-size: var(--step--1); color: var(--ink-2); line-height: 1.7; }

  /* الحالة فوق السعر لا بجانبه: رقمُ الليرة من سبع خانات لا يترك مكاناً
     لشارةٍ إلى جانبه عند 360 بكسل، فينكسر السطر بين الرقم و«ل.س». */
  .pricebox {
    display: grid; gap: 8px; justify-items: start;
    padding: 13px 14px; border-radius: var(--r-l);
    background: var(--surface); border: 1px solid var(--line);
  }
  .avail {
    font-size: var(--step--2); font-weight: var(--w-strong); color: var(--jade);
    background: color-mix(in srgb, var(--jade) 12%, transparent);
    border-radius: var(--r-pill); padding: 4px 11px;
  }
  .avail--out { color: var(--clay); background: color-mix(in srgb, var(--clay) 12%, transparent); }

  .badges { display: flex; gap: 6px; flex-wrap: wrap; }

  .cmpbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .cmplink { font-size: var(--step--1); font-weight: var(--w-strong); color: var(--brass); }

  .verify {
    display: flex; gap: 10px; align-items: flex-start; padding: 12px; border-radius: var(--r-m);
    border: 1px solid color-mix(in srgb, var(--jade) 34%, transparent);
    background: color-mix(in srgb, var(--jade) 9%, transparent);
  }
  .verify .icon { color: var(--jade); margin-block-start: 3px; }
  .verify b { display: block; font-size: var(--step--1); line-height: 1.5; }
  .verify span { font-size: var(--step--2); color: var(--ink-2); line-height: 1.65; }

  .picker { display: grid; gap: 8px; }
  .picker-h { font-size: var(--step--1); font-weight: var(--w-strong); color: var(--ink-2); }
  .opts { display: flex; gap: 8px; flex-wrap: wrap; }
  .opt {
    min-height: var(--tap-min); padding: 8px 14px; border-radius: var(--r-s);
    border: 1.5px solid var(--line); background: var(--surface);
    font: inherit; font-size: var(--step--1); font-weight: var(--w-strong); color: var(--ink-2);
    cursor: pointer; display: grid; gap: 1px; text-align: start; line-height: 1.3;
    transition: border-color var(--dur-tap) var(--ease-state), background var(--dur-tap) var(--ease-state);
  }
  .opt small { font-size: var(--step--2); color: var(--ink-3); font-weight: var(--w-strong); }
  .opt[aria-pressed='true'] {
    border-color: var(--brass); color: var(--ink);
    background: color-mix(in srgb, var(--brass) 11%, transparent);
  }

  /* الجدول مخطَّط: صفٌّ فاتح وصفٌّ داكن يجعل مسح العين رأسياً بلا تيه */
  .facts {
    display: grid; border: 1px solid var(--line); border-radius: var(--r-l);
    overflow: hidden; background: var(--surface);
  }
  .fact {
    display: flex; justify-content: space-between; gap: 14px; align-items: baseline;
    padding: 10px 14px; font-size: var(--step--1);
  }
  .fact:nth-child(odd) { background: color-mix(in srgb, var(--ink) 3%, transparent); }
  .fact dt { color: var(--ink-3); }
  .fact dd { font-weight: var(--w-strong); text-align: end; }

  .cod {
    display: flex; gap: 10px; align-items: center; padding: 12px 13px; border-radius: var(--r-m);
    background: color-mix(in srgb, var(--brass) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--brass) 26%, transparent);
    font-size: var(--step--1); font-weight: var(--w-strong); line-height: 1.55;
  }
  .cod .icon { color: var(--brass); flex: none; }

  .rsum { display: flex; align-items: baseline; gap: 10px; }
  .ravg { font-size: var(--step-3); font-weight: var(--w-strong); }
  .rstars { color: var(--brass); letter-spacing: 2px; }
  .rbars { display: grid; gap: 4px; }
  .rbar { display: grid; grid-template-columns: 1ch 1fr 3ch; gap: 8px; align-items: center; font-size: var(--step--2); }
  .rbar .track { block-size: 6px; border-radius: 99px; background: color-mix(in srgb, var(--ink) 10%, transparent); overflow: hidden; }
  .rbar .fill { display: block; block-size: 100%; background: var(--brass); }
  .rev { display: grid; gap: 5px; padding-block: 12px; border-block-start: 1px solid var(--line); }
  .rev p { color: var(--ink-2); line-height: 1.75; font-size: var(--step--1); }
  .rev .rhead { display: flex; gap: 8px; align-items: center; font-size: var(--step--2); }
  .rev .reply {
    margin-block-start: 5px; padding: 9px 11px; border-radius: var(--r-m);
    background: color-mix(in srgb, var(--jade) 8%, transparent);
    border-inline-start: 3px solid color-mix(in srgb, var(--jade) 50%, transparent);
  }

  .also { display: grid; gap: 11px; margin-block-start: var(--space-5); }
  .also h2 { font-size: var(--step-1); }

  /*
    شريط الشراء فوق شريط التنقّل لا فوقه بالمعنى البصري: كانا يتراكبان
    فيُخفي زرُّ «أضف للسلة» أيقونةَ السلة نفسها. الارتفاع يُحسب من
    --nav-h فيتبع أيَّ تغيير في الشريط السفلي تلقائياً.
  */
  .buybar {
    position: fixed; z-index: 41;
    bottom: calc(var(--nav-h) + var(--safe-b) + 14px); inset-inline: 8px;
    max-inline-size: calc(var(--content) - 16px); margin-inline: auto;
    border-radius: var(--r-l); padding: 9px 10px;
    display: flex; gap: 9px; align-items: center;
  }
  .buybar .pr { flex: 1; min-inline-size: 0; display: grid; gap: 0; }
  .buybar .pr b {
    font-size: var(--step-1); font-weight: var(--w-strong);
    font-variant-numeric: tabular-nums; white-space: nowrap;
  }
  .buybar .pr small { font-size: var(--step--2); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .buybar .btn--icon { --btn-bg: transparent; --btn-fg: var(--jade); --btn-brd: var(--line); }

  .btn--buy { flex: none; white-space: nowrap; min-inline-size: 8.5rem; }
  .btn--buy[data-busy] { opacity: 0.7; }

  /*
    الرسالة تُعرض حيث تقع العين لا حيث يقع العنصر في الشيفرة: الزبون ضغط
    زرّاً ملتصقاً بأسفل الشاشة، فرسالةٌ في وسط الصفحة تحت الطيّة لا يراها
    — والأخطر أنها رسالة الخطأ نفسها.
    فتطفو فوق شريط الشراء على الهاتف، وتعود عنصراً عادياً على الشاشة
    الواسعة حيث الشريط جزءٌ من اللوحة أصلاً.
  */
  .addmsg {
    position: fixed; z-index: 42;
    inset-inline: 12px;
    inset-block-end: calc(var(--nav-h) + var(--safe-b) + 84px);
    max-inline-size: calc(var(--content) - 24px); margin-inline: auto;
    font-size: var(--step--1); font-weight: var(--w-strong); line-height: 1.55;
    padding: 11px 13px; border-radius: var(--r-m);
    box-shadow: var(--sh-2);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  @media (min-width: 900px) {
    .addmsg { position: static; inset: auto; box-shadow: none; backdrop-filter: none; }
  }
  .addmsg[data-kind='ok'] {
    color: var(--jade);
    background: color-mix(in srgb, var(--jade) 16%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--jade) 34%, transparent);
  }
  .addmsg[data-kind='err'] {
    color: var(--clay);
    background: color-mix(in srgb, var(--clay) 16%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--clay) 34%, transparent);
  }
  .is-fading { opacity: 0; transition: opacity var(--dur-out) var(--ease-state); }

  @media (min-width: 560px) {
    .buybar { inset-inline: auto 8px; max-inline-size: 440px; }
  }

  /*
    عمودان على الشاشة الواسعة: الصورة إلى جانب قرار الشراء لا فوقه.
    عمودٌ واحد بعرض ألف بكسل يعني أن السعر يقع تحت الطيّة ويحتاج تمريراً
    ليُرى — وصفحة منتجٍ لا يُرى سعرها بلا تمرير صفحةُ عرضٍ لا صفحة بيع.
    والصورة تلتصق أثناء التمرير فتبقى مرافقةً للمواصفات تحتها.
  */
  @media (min-width: 900px) {
    .pdp {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      column-gap: var(--space-6); row-gap: var(--space-5);
      align-items: start; padding-block-start: 10px;
    }
    .crumbs, .facts, .also { grid-column: 1 / -1; }
    .pdp :global(.pm--hero) { position: sticky; top: 86px; max-inline-size: none; }
    .buy { grid-column: 2; }
    .pdp h1 { font-size: var(--step-3); }

    /* الشريط يعود عنصراً عادياً داخل اللوحة: لا حاجة إلى تعويم على شاشةٍ
       يرى فيها الزبون السعر والزرّ معاً بلا تمرير. */
    .buybar {
      position: static; inset: auto; max-inline-size: none;
      padding: 13px; margin: 0;
      /* صفّان لا صفّ: سبعُ خاناتٍ بجانب زرّين تدفع الرقم فوق الأيقونة */
      display: grid; grid-template-columns: 1fr auto; gap: 11px;
    }
    .buybar .pr { grid-column: 1 / -1; grid-row: 1; }
    .buybar .pr b { font-size: var(--step-1); }
    .buybar .btn--icon { grid-column: 2; grid-row: 2; }
    .btn--buy { grid-column: 1; grid-row: 2; inline-size: 100%; }
  }
</style>
