---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { LEGAL } from '../../lib/legal';

export function getStaticPaths() {
  return LEGAL.map((d) => ({ params: { slug: d.slug }, props: { doc: d } }));
}

const { doc } = Astro.props;
const others = LEGAL.filter((d) => d.slug !== doc.slug);
---

<Base title={doc.title} description={doc.summary}>
  <Header title={doc.title} back="/help/" />

  <article class="container">
    <div class="pagehead">
      <p class="eyebrow">وثيقة</p>
      <h1>{doc.title}</h1>
      <p class="lede">{doc.summary}</p>
      <p class="updated tnum">آخر تحديث: {doc.updated}</p>
    </div>

    {doc.sections.map((s) => (
      <section class="sec glass">
        <h2>{s.h}</h2>
        {s.p.map((t) => <p>{t}</p>)}
      </section>
    ))}

    <nav class="links" aria-label="وثائق أخرى">
      {others.map((d) => <a class="chip" href={`/legal/${d.slug}/`}>{d.title}</a>)}
    </nav>
  </article>
</Base>

<style>
  .container { display: grid; gap: 12px; }
  .updated { font-size: var(--step--2); color: var(--ink-3); font-weight: 700; }
  .sec { padding: 14px; border-radius: var(--r-l); display: grid; gap: 8px; }
  .sec h2 { font-size: var(--step-0); font-weight: 800; }
  .sec p { color: var(--ink-2); line-height: 1.85; font-size: var(--step--1); }
  .links { display: flex; gap: 6px; flex-wrap: wrap; }
  .links { margin-block: 4px; }
</style>
