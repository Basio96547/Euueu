{
  // نشر موقع تالي شام على Cloudflare Workers بأصول ساكنة.
  // الأمر: npx wrangler deploy   (من داخل apps/site)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talisham",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_SITE_URL": "https://talisham.com"
  }
  // بعد ربط النطاق في لوحة Cloudflare أضف:
  // "routes": [{ "pattern": "talisham.com", "custom_domain": true }]
}
