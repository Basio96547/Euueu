{
  "name": "@talisham/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "tsx prisma/seed.ts",
    "purge-demo": "tsx prisma/purge-demo.ts",
    "grant-role": "tsx prisma/grant-role.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "@talisham/types": "workspace:*",
    "@talisham/ui": "workspace:*",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hono/node-server": "^2.0.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "4.115.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
