{
  "name": "@talisham/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "generate": "prisma generate",
    "migration:new": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/tmp.sql && node prisma/apply-constraints.mjs prisma/migrations/tmp.sql"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.2.1",
    "@talisham/types": "workspace:*",
    "@talisham/ui": "workspace:*",
    "hono": "^4.12.32",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@hono/node-server": "^2.0.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "4.115.0"
  }
}
