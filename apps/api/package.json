{
  "name": "@talisham/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "tsx prisma/seed.ts",
    "purge-demo": "tsx prisma/purge-demo.ts",
    "grant-role": "tsx prisma/grant-role.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@talisham/types": "workspace:*",
    "@talisham/ui": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@nestjs/cli": "^11.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
