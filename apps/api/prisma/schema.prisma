// تالي شام — مخطط قاعدة البيانات على Cloudflare D1 (SQLite)
//
// المرجع: الفصل 3. ثلاثة فروق عن نصّ الفصل، وكلها في التمثيل لا في المعنى:
//   • الأنواع المعدودة: SQLite بلا ENUM، فالقيم نصوص محروسة بقيود CHECK
//     مولَّدة في الترحيل — القيمة الخاطئة ترفضها القاعدة كما كانت ترفضها.
//   • المعرّفات: UUID تُولَّد في العميل بدل gen_random_uuid().
//   • القيود والمحفِّزات: مكتوبة بلهجة SQLite في الترحيلات — انظر
//     prisma/sql/constraints.sql. ومحفِّز تطابق المخزون باقٍ كما هو معنى.

generator client {
  provider = "prisma-client-js"
  // محوّل السائق ومترجم استعلامات بلا Rust: شرط تشغيل Prisma داخل
  // Cloudflare Worker، فالمحرك الثنائي الأصلي لا مكان له هناك.
  previewFeatures = ["driverAdapters", "queryCompiler"]
}

datasource db {
  provider = "sqlite"
  // رابطٌ صوري: العميل يُولَّد منه ولا يتصل به أبداً — الاتصال الحقيقي
  // عبر ربط D1 في `wrangler.jsonc` وحده.
  url      = "file:./unused.db"
}

// ——————————————————— الأنواع ———————————————————

// ——————————————————— الهوية والعناوين ———————————————————

model User {
  id              String    @id @default(uuid())
  publicId        String    @unique @map("public_id")
  phoneE164       String    @unique @map("phone_e164")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  fullName        String?   @map("full_name")
  role            String  @default("CUSTOMER")
  locale          String    @default("ar")
  displayCurrency String    @default("SYP") @map("display_currency")
  tokenVersion    Int       @default(0) @map("token_version")
  /// كلمة سرّ للحسابات الإدارية فقط: مخزَّنة كـ scrypt بملح لكل حساب.
  /// الزبون يدخل برمز واتساب ولا حاجة به إليها. ووجودها للموظّف ضرورة
  /// لا رفاهية: الاعتماد على الواتساب وحده يعني أن انقطاع مزوّد الرسائل
  /// يقفل لوحة التحكم في وجه صاحبها.
  passwordHash    String?   @map("password_hash")
  passwordSetAt   DateTime? @map("password_set_at")
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  /// تفضيلات الإشعار: {"orders":true,"promos":false,...} — حقل واحد بدل
  /// جدول لصفٍّ واحد لكل مستخدم لا يُستعلَم عليه إلا مع صاحبه
  notifyPrefs     Json      @default("{}") @map("notify_prefs")

  addresses       Address[]
  orders          Order[]
  carts           Cart[]
  reviews         Review[]
  questions       ProductQuestion[]
  priceAlerts     PriceAlert[]
  stockAlerts     StockAlert[]
  ticketsOwned    SupportTicket[]    @relation("TicketOwner")
  ticketsAssigned SupportTicket[]    @relation("TicketAssignee")
  settlements     CashSettlement[]   @relation("SettlementCollector")
  pushSubs        PushSubscription[]
  notifications   Notification[]
  courier         Courier?
  sessions        Session[]
  wishlist        WishlistItem[]
  deletionRequests AccountDeletionRequest[]
  readinessChecked ReadinessCheck[]
  routineRuns      OpsRoutineRun[]

  @@map("users")
}

model Address {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  label         String?
  recipientName String      @map("recipient_name")
  governorate   String
  city          String
  neighborhood  String
  street        String?
  /// إلزامي: العناوين الرسمية غير موثوقة عملياً، والمندوب يصل بالمعلم
  landmark      String
  details       String?
  phone         String
  altPhone      String?     @map("alt_phone")
  geoLat        Decimal?    @map("geo_lat")
  geoLng        Decimal?    @map("geo_lng")
  isDefault     Boolean     @default(false) @map("is_default")
  createdAt     DateTime    @default(now()) @map("created_at")
  deletedAt     DateTime?   @map("deleted_at")

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ——————————————————— الكتالوج ———————————————————

model Brand {
  id              String  @id @default(uuid())
  slug            String  @unique
  name            Json
  countryOfOrigin String? @map("country_of_origin")
  isFeatured      Boolean @default(false) @map("is_featured")
  sortOrder       Int     @default(0) @map("sort_order")

  products Product[]

  @@map("brands")
}

model Category {
  id        String  @id @default(uuid())
  parentId  String? @map("parent_id")
  slug      String  @unique
  name      Json
  path      String
  depth     Int     @default(0)
  sortOrder Int     @default(0) @map("sort_order")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([path])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  publicId    String        @unique @map("public_id")
  slug        String        @unique
  brandId     String        @map("brand_id")
  categoryId  String        @map("category_id")
  name        Json
  shortDesc   Json?         @map("short_desc")
  description Json?
  spec        Json?
  status      String @default("DRAFT")
  /// منتج بذرة تجريبي: مستبعَد من الفهرس، ولا يقبل طلباً، ويمنع الإقلاع في الإنتاج
  isDemo      Boolean       @default(false) @map("is_demo")
  ratingAvg   Decimal?      @map("rating_avg")
  ratingCount Int           @default(0) @map("rating_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  brand    Brand            @relation(fields: [brandId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  media    Media[]

  accessoryFor   ProductCompatibility[] @relation("AccessorySide")
  compatibleWith ProductCompatibility[] @relation("PhoneSide")
  reviews        Review[]
  questions      ProductQuestion[]

  @@index([status, isDemo])
  @@map("products")
}

model ProductVariant {
  id                     String           @id @default(uuid())
  publicId               String           @unique @map("public_id")
  productId              String           @map("product_id")
  sku                    String           @unique
  colorCode              String?          @map("color_code")
  colorName              Json?            @map("color_name")
  storageGb              Int?             @map("storage_gb")
  ramGb                  Int?             @map("ram_gb")
  networkGen             String?      @map("network_gen")
  dualSim                Boolean          @default(false) @map("dual_sim")
  esimOnly               Boolean          @default(false) @map("esim_only")
  /// رمز النسخة المطبوع على العلبة: ZA/A · LL/A · AA/A
  partCode               String?          @map("part_code")
  condition              String @default("NEW")
  batteryHealthPct       Int?             @map("battery_health_pct")
  deviceOrigin           String
  warrantyType           String
  warrantyMonths         Int              @map("warranty_months")
  /// التخزين المرجعي بسنتات الدولار — الليرة طبقة عرض (الفصل 3)
  priceUsdCents          BigInt           @map("price_usd_cents")
  compareAtPriceUsdCents BigInt?          @map("compare_at_price_usd_cents")
  costPriceUsdCents      BigInt?          @map("cost_price_usd_cents")
  isDefault              Boolean          @default(false) @map("is_default")
  deletedAt              DateTime?        @map("deleted_at")

  product      Product                @relation(fields: [productId], references: [id])
  levels       InventoryLevel[]
  units        DeviceUnit[]
  reservations InventoryReservation[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  priceAlerts  PriceAlert[]
  stockAlerts  StockAlert[]
  poLines      PurchaseOrderLine[]
  wishlistedBy WishlistItem[]

  @@unique([productId, storageGb, ramGb, colorCode, deviceOrigin, partCode])
  @@index([productId])
  @@map("product_variants")
}

model ProductCompatibility {
  id                 String @id @default(uuid())
  accessoryProductId String @map("accessory_product_id")
  phoneProductId     String @map("phone_product_id")
  note               Json?

  accessory Product @relation("AccessorySide", fields: [accessoryProductId], references: [id])
  phone     Product @relation("PhoneSide", fields: [phoneProductId], references: [id])

  @@unique([accessoryProductId, phoneProductId])
  @@index([phoneProductId])
  @@map("product_compatibility")
}

/// جدول الوسائط الوحيد — لا جدول وسائط خاص بالمنتجات
model Media {
  id              String  @id @default(uuid())
  ownerType       String  @map("owner_type")
  ownerId         String  @map("owner_id")
  url             String
  alt             Json?
  colorCode       String? @map("color_code")
  blurhash        String?
  isRealUnitPhoto Boolean @default(false) @map("is_real_unit_photo")
  sortOrder       Int     @default(0) @map("sort_order")

  product Product? @relation(fields: [ownerId], references: [id])

  @@index([ownerType, ownerId])
  @@map("media")
}

// ——————————————————— المخزون ———————————————————

model Warehouse {
  id          String      @id @default(uuid())
  code        String      @unique
  name        Json
  governorate String

  levels InventoryLevel[]
  units  DeviceUnit[]

  @@map("warehouses")
}

/// مصدر الكمية الوحيد. المتاح = onHand - reserved، بقفل متفائل على version.
model InventoryLevel {
  id           String @id @default(uuid())
  variantId    String @map("variant_id")
  warehouseId  String @map("warehouse_id")
  onHand       Int    @default(0) @map("on_hand")
  reserved     Int    @default(0)
  incoming     Int    @default(0)
  reorderPoint Int    @default(0) @map("reorder_point")
  version      Int    @default(0)

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@map("inventory_levels")
}

model InventoryReservation {
  id          String          @id @default(uuid())
  variantId   String          @map("variant_id")
  warehouseId String          @map("warehouse_id")
  kind        String
  qty         Int
  cartId      String?         @map("cart_id")
  orderId     String?         @map("order_id")
  expiresAt   DateTime        @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([expiresAt])
  @@index([orderId])
  @@map("inventory_reservations")
}

/// دفتر الحركات — الاسم الوحيد
model InventoryMovement {
  id          String         @id @default(uuid())
  variantId   String         @map("variant_id")
  warehouseId String         @map("warehouse_id")
  reason      String
  qtyDelta    Int            @map("qty_delta")
  refType     String?        @map("ref_type")
  refId       String?        @map("ref_id")
  actorId     String?        @map("actor_id")
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([variantId, createdAt])
  @@map("inventory_movements")
}

/// وحدات الأجهزة: عددها بحالة IN_STOCK يجب أن يساوي onHand — مفروض بمحفِّز مؤجَّل
model DeviceUnit {
  id                      String          @id @default(uuid())
  variantId               String          @map("variant_id")
  warehouseId             String          @map("warehouse_id")
  imei                    String?         @unique
  imei2                   String?
  serial                  String?
  state                   String @default("IN_STOCK")
  grade                   String?
  batteryHealthPct        Int?            @map("battery_health_pct")
  imeiCheckStatus         String?         @map("imei_check_status")
  orderItemId             String?         @unique @map("order_item_id")
  warrantyType            String?   @map("warranty_type")
  warrantyStartAt         DateTime?       @map("warranty_start_at")
  warrantyEndAt           DateTime?       @map("warranty_end_at")
  acquisitionCostUsdCents BigInt?         @map("acquisition_cost_usd_cents")

  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id])
  claims    WarrantyClaim[]

  @@index([variantId, state])
  @@map("device_units")
}

// ——————————————————— سعر الصرف ———————————————————

/// سجل تاريخي غير قابل للتعديل. التقادم ليس حالة مسموحة: validUntil إلزامي.
model FxRate {
  id             String   @id @default(uuid())
  base           String   @default("USD")
  quote          String   @default("SYP")
  rate           Decimal
  effectiveFrom  DateTime @map("effective_from")
  validUntil     DateTime @map("valid_until")
  safetyMarginBp Int      @default(300) @map("safety_margin_bp")
  setBy          String?  @map("set_by")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  orders Order[]

  @@unique([quote, effectiveFrom])
  @@index([effectiveFrom])
  @@map("fx_rates")
}

// ——————————————————— السلة والطلب ———————————————————

model Cart {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String?  @map("user_id")
  /// الرمز يُحفظ لا الخصم: القيمة تُعاد حسابها عند كل عرض، فلو تغيّر
  /// سعر أو انتهت صلاحية الكوبون بين الإضافة والطلب ظهر ذلك فوراً.
  couponCode String?  @map("coupon_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                        String @id @default(uuid())
  cartId                    String @map("cart_id")
  variantId                 String @map("variant_id")
  qty                       Int    @default(1)
  unitPriceSnapshotUsdCents BigInt @map("unit_price_snapshot_usd_cents")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                String      @id @default(uuid())
  publicId          String      @unique @map("public_id")
  /// TS-YYMM-NNNNNN — القيد في constraints.sql
  orderNo           String      @unique @map("order_no")
  userId            String?     @map("user_id")
  status            String @default("PENDING_CONFIRMATION")
  shippingAddressId String      @map("shipping_address_id")
  /// المندوب المُسنَد إليه الطلب. بلا هذا الحقل كان كل مندوب يرى كل
  /// طلبات المتجر بأسماء زبائنها وأرقامهم وعناوينهم في هاتفه.
  courierId         String?     @map("courier_id")

  subtotalUsdCents      BigInt @map("subtotal_usd_cents")
  discountTotalUsdCents BigInt @default(0) @map("discount_total_usd_cents")
  shippingTotalUsdCents BigInt @default(0) @map("shipping_total_usd_cents")
  taxRateBp             Int    @default(0) @map("tax_rate_bp")
  taxAmountUsdCents     BigInt @default(0) @map("tax_amount_usd_cents")
  totalUsdCents         BigInt @map("total_usd_cents")

  fxRateId         String?  @map("fx_rate_id")
  fxRate           Decimal  @map("fx_rate")
  totalSyp         BigInt   @map("total_syp")
  /// فرق التقريب يُخزَّن وإلا لم تتطابق التسويات أبداً (الفصل 16)
  roundingDiffSyp  Int      @default(0) @map("rounding_diff_syp")
  fxStale          Boolean  @default(false) @map("fx_stale")
  priceLockedUntil DateTime @map("price_locked_until")

  paymentMethod      String @default("COD") @map("payment_method")
  paymentStatus      String @default("PENDING") @map("payment_status")
  collectedAmountSyp BigInt?       @map("collected_amount_syp")
  collectedAt        DateTime?     @map("collected_at")
  collectedBy        String?       @map("collected_by")

  confirmationAttempts Int       @default(0) @map("confirmation_attempts")
  confirmedBy          String?   @map("confirmed_by")
  confirmedAt          DateTime? @map("confirmed_at")
  confirmationNotes    String?   @map("confirmation_notes")

  /// من حصّل ونوعه وأي تسوية يومية يقع فيها — الفصل 8 §8.7
  collectorType String? @map("collector_type")
  settlementId  String?        @map("settlement_id")
  deliveredAt   DateTime?      @map("delivered_at")
  /// الطلب البديل يشير إلى أصله فلا ينقطع خيط الاستبدال
  replacementOf String?        @map("replacement_of")
  couponCode    String?        @map("coupon_code")

  placedAt  DateTime @default(now()) @map("placed_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user            User?                @relation(fields: [userId], references: [id])
  shippingAddress Address              @relation(fields: [shippingAddressId], references: [id])
  fx              FxRate?              @relation(fields: [fxRateId], references: [id])
  items           OrderItem[]
  history         OrderStatusHistory[]
  returns         Return[]
  tickets         SupportTicket[]
  redemption      CouponRedemption?
  settlement      CashSettlement?      @relation(fields: [settlementId], references: [id])
  courier         Courier?             @relation(fields: [courierId], references: [id])

  @@index([status, placedAt])
  @@index([courierId, status])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(uuid())
  orderId           String  @map("order_id")
  variantId         String  @map("variant_id")
  qty               Int     @default(1)
  unitPriceUsdCents BigInt  @map("unit_price_usd_cents")
  lineTotalUsdCents BigInt  @map("line_total_usd_cents")
  cogsUsdCents      BigInt? @map("cogs_usd_cents")
  nameSnapshot      Json    @map("name_snapshot")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])
  unit    DeviceUnit?

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  fromStatus String? @map("from_status")
  toStatus   String  @map("to_status")
  actorType  String       @map("actor_type")
  actorId    String?      @map("actor_id")
  reasonCode String?      @map("reason_code")
  source     String       @default("SYSTEM")
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model ShippingRate {
  id                String         @id @default(uuid())
  governorate       String
  method            String
  baseFeeUsdCents   BigInt         @map("base_fee_usd_cents")
  perKgFeeUsdCents  BigInt         @default(0) @map("per_kg_fee_usd_cents")
  freeAboveUsdCents BigInt?        @map("free_above_usd_cents")
  etaMinDays        Int            @map("eta_min_days")
  etaMaxDays        Int            @map("eta_max_days")

  @@unique([governorate, method])
  @@map("shipping_rates")
}

// ——————————————————— الإعدادات وسجل التدقيق ———————————————————

model StoreSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════
//  التسوية النقدية — الفصل 8 §8.7
// ═══════════════════════════════════════════════════════════════

/// صف واحد لكل (محصِّل، يوم). بدونه لا يُعرف أين المال:
/// المتجر يعمل نقداً، فالمطابقة اليومية هي دفتر الصندوق كلّه.
model CashSettlement {
  id             String        @id @default(uuid())
  collectorType  String @map("collector_type")
  collectorId    String        @map("collector_id")
  settlementDate DateTime      @map("settlement_date")

  ordersCount           Int    @default(0) @map("orders_count")
  expectedAmountSyp     BigInt @default(0) @map("expected_amount_syp")
  collectedAmountSyp    BigInt @default(0) @map("collected_amount_syp")
  /// محسوب: collected − expected. يُخزَّن ليُقرأ في التقارير بلا إعادة حساب
  varianceSyp           BigInt @default(0) @map("variance_syp")
  roundingDiffSyp       Int    @default(0) @map("rounding_diff_syp")
  deliveryCommissionSyp BigInt @default(0) @map("delivery_commission_syp")

  state        String @default("OPEN")
  note         String?
  /// من أقفل التسوية — ولا يجوز أن يكون المحصِّل نفسه (الفصل 9 §فصل الواجبات)
  reconciledBy String?         @map("reconciled_by")
  reconciledAt DateTime?       @map("reconciled_at")
  settledAt    DateTime?       @map("settled_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  collector User    @relation("SettlementCollector", fields: [collectorId], references: [id])
  orders    Order[]

  @@unique([collectorType, collectorId, settlementDate])
  @@index([state, settlementDate])
  @@map("cash_settlements")
}

// ═══════════════════════════════════════════════════════════════
//  الإرجاع والاسترداد — الفصل 8 §8.10
// ═══════════════════════════════════════════════════════════════

model Return {
  id           String       @id @default(uuid())
  returnNo     String       @unique @map("return_no")
  orderId      String       @map("order_id")
  orderItemId  String?      @map("order_item_id")
  state        String  @default("REQUESTED")
  reason       String
  customerNote String?      @map("customer_note")

  /// فحص IMEI إلزامي: جهاز غير الجهاز المُباع لا يُقبل مهما بدا مطابقاً
  imeiSubmitted String?  @map("imei_submitted")
  imeiChecked   Boolean  @default(false) @map("imei_checked")
  imeiMatched   Boolean? @map("imei_matched")

  inspectionNote String? @map("inspection_note")
  rejectReason   String? @map("reject_reason")
  restock        Boolean @default(false)

  requestedAt DateTime  @default(now()) @map("requested_at")
  decidedAt   DateTime? @map("decided_at")
  receivedAt  DateTime? @map("received_at")
  completedAt DateTime? @map("completed_at")
  decidedBy   String?   @map("decided_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  order  Order   @relation(fields: [orderId], references: [id])
  refund Refund?

  @@index([state, requestedAt])
  @@index([orderId])
  @@map("returns")
}

/// الاسترداد نقداً: المبلغ بالدولار مرجعاً وبالليرة مقرَّباً لأقرب ألف،
/// ولا يُصرف قبل تطابق IMEI — النقد لا يُسترجَع بعد خروجه.
model Refund {
  id              String      @id @default(uuid())
  returnId        String      @unique @map("return_id")
  amountUsdCents  BigInt      @map("amount_usd_cents")
  fxRate          Decimal     @map("fx_rate")
  amountSyp       BigInt      @map("amount_syp")
  roundingDiffSyp Int         @default(0) @map("rounding_diff_syp")
  state           String @default("PENDING")
  disbursedBy     String?     @map("disbursed_by")
  disbursedAt     DateTime?   @map("disbursed_at")
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([state])
  @@map("refunds")
}

// ═══════════════════════════════════════════════════════════════
//  الكفالة: مطالبة بجدول حقيقي لا سطراً في سجل التدقيق — الفصل 15
// ═══════════════════════════════════════════════════════════════

model WarrantyClaim {
  id           String     @id @default(uuid())
  claimNo      String     @unique @map("claim_no")
  deviceUnitId String?    @map("device_unit_id")
  imei         String?
  phone        String
  description  String
  state        String @default("OPENED")
  diagnosis    String?
  resolution   String?
  rejectReason String?    @map("reject_reason")
  loanerUnitId String?    @map("loaner_unit_id")
  openedAt     DateTime   @default(now()) @map("opened_at")
  closedAt     DateTime?  @map("closed_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  unit    DeviceUnit?     @relation(fields: [deviceUnitId], references: [id])
  tickets SupportTicket[]

  @@index([state, openedAt])
  @@index([phone])
  @@map("warranty_claims")
}

// ═══════════════════════════════════════════════════════════════
//  الدعم: التذاكر — الفصل 14 §14.7
// ═══════════════════════════════════════════════════════════════

model SupportTicket {
  id              String  @id @default(uuid())
  ticketNo        String  @unique @map("ticket_no")
  userId          String? @map("user_id")
  phone           String
  orderId         String? @map("order_id")
  deviceUnitId    String? @map("device_unit_id")
  warrantyClaimId String? @map("warranty_claim_id")

  channel          String  @default("WEB")
  externalThreadId String?        @map("external_thread_id")
  subject          String?
  contactReason    String         @map("contact_reason")
  status           String   @default("NEW")
  priority         String @default("NORMAL")
  assigneeId       String?        @map("assignee_id")

  firstResponseAt       DateTime? @map("first_response_at")
  resolvedAt            DateTime? @map("resolved_at")
  closedAt              DateTime? @map("closed_at")
  /// المهل تُحسب ضمن ساعات العمل لا على مدار الساعة: الكهرباء تنقطع
  slaFirstResponseDueAt DateTime? @map("sla_first_response_due_at")
  slaResolutionDueAt    DateTime? @map("sla_resolution_due_at")
  slaBreached           Boolean   @default(false) @map("sla_breached")

  csatScore   Int?     @map("csat_score")
  csatComment String?  @map("csat_comment")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User?           @relation("TicketOwner", fields: [userId], references: [id])
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  order    Order?          @relation(fields: [orderId], references: [id])
  claim    WarrantyClaim?  @relation(fields: [warrantyClaimId], references: [id])
  messages TicketMessage[]

  @@index([status, priority, createdAt])
  @@index([phone])
  @@index([orderId])
  @@map("support_tickets")
}

model TicketMessage {
  id              String         @id @default(uuid())
  ticketId        String         @map("ticket_id")
  authorType      String         @map("author_type")
  authorId        String?        @map("author_id")
  body            String
  isInternalNote  Boolean        @default(false) @map("is_internal_note")
  macroId         String?        @map("macro_id")
  deliveryChannel String? @map("delivery_channel")
  deliveryStatus  String?        @map("delivery_status")
  createdAt       DateTime       @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  macro  TicketMacro?  @relation(fields: [macroId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketMacro {
  id         String   @id @default(uuid())
  code       String   @unique
  title      Json
  body       Json
  /// قائمة نصية مخزَّنة JSON: SQLite بلا مصفوفات بدائية
  variables  Json     @default("[]")
  isActive   Boolean  @default(true) @map("is_active")
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at")

  messages TicketMessage[]

  @@map("ticket_macros")
}

// ═══════════════════════════════════════════════════════════════
//  التقييمات والأسئلة — الفصل 14 §14.5
// ═══════════════════════════════════════════════════════════════

/// لا مراجعة بلا شراء مسلَّم: order_item_id إلزامي وفريد،
/// فلا يكتب أحد رأياً في جهاز لم يمسكه بيده.
model Review {
  id              String           @id @default(uuid())
  productId       String           @map("product_id")
  userId          String           @map("user_id")
  orderItemId     String           @unique @map("order_item_id")
  rating          Int
  title           String?
  body            String?
  status          String @default("PENDING")
  rejectReason    String?          @map("reject_reason")
  flagged         Boolean          @default(false)
  helpfulCount    Int              @default(0) @map("helpful_count")
  merchantReply   String?          @map("merchant_reply")
  merchantReplyAt DateTime?        @map("merchant_reply_at")
  moderatedBy     String?          @map("moderated_by")
  moderatedAt     DateTime?        @map("moderated_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  product Product        @relation(fields: [productId], references: [id])
  user    User           @relation(fields: [userId], references: [id])
  reports ReviewReport[]

  @@index([productId, status])
  @@map("reviews")
}

model ReviewReport {
  id         String    @id @default(uuid())
  reviewId   String    @map("review_id")
  reporterId String?   @map("reporter_id")
  reason     String
  note       String?
  status     String    @default("OPEN")
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, reporterId])
  @@map("review_reports")
}

model ProductQuestion {
  id           String           @id @default(uuid())
  productId    String           @map("product_id")
  userId       String           @map("user_id")
  body         String
  answerBody   String?          @map("answer_body")
  answerSource String?          @map("answer_source")
  answeredBy   String?          @map("answered_by")
  answeredAt   DateTime?        @map("answered_at")
  status       String @default("PENDING")
  rejectReason String?          @map("reject_reason")
  helpfulCount Int              @default(0) @map("helpful_count")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId, status])
  @@map("product_questions")
}

// ═══════════════════════════════════════════════════════════════
//  الكوبونات — الفصل 7 §7.7
// ═══════════════════════════════════════════════════════════════

/// كل المبالغ بسنتات الدولار: خصمٌ بالليرة يفقد معناه بعد أول قفزة صرف.
model Coupon {
  id                    String     @id @default(uuid())
  code                  String     @unique
  type                  String
  /// نسبة مئوية (1–100) أو مبلغ بسنتات الدولار حسب النوع
  value                 Int
  maxDiscountUsdCents   Int?       @map("max_discount_usd_cents")
  minSubtotalUsdCents   Int        @default(0) @map("min_subtotal_usd_cents")
  /// قائمة نصية مخزَّنة JSON: SQLite بلا مصفوفات بدائية
  categorySlugs         Json       @default("[]") @map("category_slugs")
  startsAt              DateTime   @map("starts_at")
  endsAt                DateTime   @map("ends_at")
  usageLimitTotal       Int?       @map("usage_limit_total")
  usageLimitPerCustomer Int        @default(1) @map("usage_limit_per_customer")
  firstOrderOnly        Boolean    @default(false) @map("first_order_only")
  stackable             Boolean    @default(false)
  usedCount             Int        @default(0) @map("used_count")
  isActive              Boolean    @default(true) @map("is_active")
  note                  String?
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@index([isActive, endsAt])
  @@map("coupons")
}

/// الحد لكل عميل مرتبط بالجوال الموثّق لا بالجلسة: الجلسة تُمحى بضغطة.
model CouponRedemption {
  id               String   @id @default(uuid())
  couponId         String   @map("coupon_id")
  orderId          String   @unique @map("order_id")
  phone            String
  discountUsdCents Int      @map("discount_usd_cents")
  createdAt        DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId, phone])
  @@map("coupon_redemptions")
}

// ═══════════════════════════════════════════════════════════════
//  التنبيهات — الفصل 14 §14.6
// ═══════════════════════════════════════════════════════════════

/// المقارنة بالدولار حصراً: لو قِيست بالليرة لأطلقت كل قفزة صرف
/// موجةَ تنبيهات كاذبة عن «انخفاض سعر» لم يحدث.
model PriceAlert {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  variantId         String    @map("variant_id")
  basePriceUsdCents BigInt    @map("base_price_usd_cents")
  thresholdBp       Int       @default(500) @map("threshold_bp")
  isActive          Boolean   @default(true) @map("is_active")
  lastNotifiedAt    DateTime? @map("last_notified_at")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@map("price_alerts")
}

/// اشتراك متصفح بإشعارات الويب — الفصل 20
/// الاشتراك مربوط بالجهاز لا بالحساب: الزبون قد يتصفّح بلا دخول،
/// وحرمانُه الإشعار حتى يسجّل يعني ألا يعرف أن طلبه خرج للتوصيل.
model PushSubscription {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  phone      String?
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  isActive   Boolean   @default(true) @map("is_active")
  failCount  Int       @default(0) @map("fail_count")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([phone])
  @@map("push_subscriptions")
}

/// صندوق الإشعارات داخل التطبيق.
///
/// كان `IN_APP` مذكوراً في قنوات كل مستوى ولا يُسلَّم إلى أي مكان: الموجّه
/// يعالج واتساب وSMS فقط، فيُحصى في «المخطَّط» ولا يصل. وواتساب التجاري
/// ممنوع على سوريا، ولا مزوّد SMS مضبوطاً، والقناتان تُرجعان `ok: true`
/// وهما محاكاة — فكل إشعارات المتجر تخرج إلى سطر سجلّ ويُقال إنها وصلت.
///
/// وهذا الجدول يجعل القناة الوحيدة التي لا تحتاج مزوّداً قناةً حقيقية:
/// الرسالة تُحفظ، والزبون يفتح التطبيق فيجدها. ويصير منعُ التكرار على
/// صفوفٍ في القاعدة لا على `Map` في الذاكرة — والعزلات في Worker كثيرة،
/// فذاكرةُ واحدةٍ لا تعرف ما أرسلته أختها.
model Notification {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  /// الرقم يبقى ولو لم يُنشأ حساب: الطلب يُقبل من زائر
  phone      String
  type       String
  level      String    @default("P2")
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  /// وجهة النقر داخل التطبيق — إشعارٌ لا يُفضي إلى شيء نصفُ إشعار
  href       String?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([phone, createdAt])
  @@index([userId, createdAt])
  /// منع التكرار يسأل عن (الرقم، النوع، الكيان) في آخر يوم
  @@index([phone, type, entityId])
  @@map("notifications")
}

model StockAlert {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  phone      String
  variantId  String    @map("variant_id")
  isActive   Boolean   @default(true) @map("is_active")
  notifiedAt DateTime? @map("notified_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User?          @relation(fields: [userId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([phone, variantId])
  @@map("stock_alerts")
}

// ═══════════════════════════════════════════════════════════════
//  إدارة التوصيل — الفصل 17
// ═══════════════════════════════════════════════════════════════

/// سجل تشغيلي مستقل عن حساب الدخول: المندوب قد يُوقَف تشغيلياً
/// مع بقاء حسابه ليطّلع على مستحقاته — إيقافُ عمله ليس مصادرةَ ماله.
model Courier {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  code             String         @unique
  fullName         String         @map("full_name")
  phone            String
  employmentType   String @default("CONTRACTOR") @map("employment_type")
  vehicleType      String    @default("MOTORCYCLE") @map("vehicle_type")
  vehiclePlate     String?        @map("vehicle_plate")
  homeGovernorate  String    @map("home_governorate")
  dailyCapacity    Int            @default(18) @map("daily_capacity")
  /// السقف النقدي بالمرجع الدولاري: الليرة تتغيّر والسقف لا يتبعها يدوياً
  cashCapUsdCents  BigInt         @default(200000) @map("cash_cap_usd_cents")
  status           String  @default("OFF_DUTY")
  suspensionReason String?        @map("suspension_reason")
  /// كفيل شخصي — عرف سوري راسخ يقلّل مخاطر النقد
  guarantorName    String?        @map("guarantor_name")
  guarantorPhone   String?        @map("guarantor_phone")
  depositUsdCents  BigInt         @default(0) @map("deposit_usd_cents")
  ratingAvg        Decimal?       @map("rating_avg")
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id])
  zones      CourierZone[]
  orders     Order[]
  defaultFor DeliveryZone[] @relation("ZoneDefaultCourier")

  @@index([status, active])
  @@map("couriers")
}

/// وحدة التخطيط هي الحي لا الرمز البريدي: المدينة السورية تُعرف
/// بأسماء أحيائها، ولا رموز بريدية عاملة تُبنى عليها خريطة توصيل.
model DeliveryZone {
  id                String      @id @default(uuid())
  code              String      @unique
  name              Json
  governorate       String
  city              String
  /// أسماء الأحياء ومرادفاتها الشائعة — المطابقة بالاسم لا بالإحداثيات
  /// قائمة نصية مخزَّنة JSON: SQLite بلا مصفوفات بدائية
  neighborhoods     Json        @default("[]")
  zoneType          String    @default("URBAN_CORE") @map("zone_type")
  surchargeUsdCents Int         @default(0) @map("surcharge_usd_cents")
  slaHours          Int         @default(24) @map("sla_hours")
  defaultCourierId  String?     @map("default_courier_id")
  codMaxUsdCents    BigInt?     @map("cod_max_usd_cents")
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  defaultCourier Courier?      @relation("ZoneDefaultCourier", fields: [defaultCourierId], references: [id])
  couriers       CourierZone[]

  @@index([governorate, active])
  @@map("delivery_zones")
}

model CourierZone {
  courierId String @map("courier_id")
  zoneId    String @map("zone_id")
  /// الأصغر أولى: مندوب المنطقة الأساسي قبل من يغطّيها احتياطاً
  priority  Int    @default(10)

  courier Courier      @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone    DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([courierId, zoneId])
  @@map("courier_zones")
}

/// عرض الكمية — الفصل 7 §7.7
/// «ثلاث قطع بخصم 10%» لمحلات الجوالات الصغيرة التي تشتري بالجملة.
/// الشريحة على مستوى المتغيّر أو الفئة، والأسعار بسنتات الدولار كغيرها.
model QuantityBreak {
  id           String   @id @default(uuid())
  /// أحدهما لا كلاهما: شريحة على صنف بعينه أو على فئة كاملة
  variantSku   String?  @map("variant_sku")
  categorySlug String?  @map("category_slug")
  minQty       Int      @map("min_qty")
  /// نسبة الخصم بنقاط الأساس: 1000 = 10%
  discountBp   Int      @map("discount_bp")
  isActive     Boolean  @default(true) @map("is_active")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([variantSku, minQty])
  @@index([categorySlug, minQty])
  @@map("quantity_breaks")
}

/// الحزمة — الفصل 7 §7.7
/// «جوال + بطارية طاقة + واقي شاشة» بسعر أقل من مجموع مفرداتها.
/// تُباع هنا جيداً لأن الزبون يشتري الجهاز مرة كل سنتين ويريد
/// أن ينتهي من ملحقاته في الزيارة نفسها.
model Bundle {
  id            String    @id @default(uuid())
  code          String    @unique
  name          Json
  description   Json?
  /// سعر الحزمة كاملاً بسنتات الدولار — لا نسبة خصم:
  /// الرقم المعلن أوضح للزبون من حسابٍ يُجريه في رأسه
  priceUsdCents Int       @map("price_usd_cents")
  startsAt      DateTime? @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  items BundleItem[]

  @@index([isActive, endsAt])
  @@map("bundles")
}

model BundleItem {
  id         String @id @default(uuid())
  bundleId   String @map("bundle_id")
  variantSku String @map("variant_sku")
  qty        Int    @default(1)

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, variantSku])
  @@map("bundle_items")
}

// ——————————————————— المشتريات والموردون (الفصل 16) ———————————————————

/// المورد جدولٌ لا اسمٌ نصّي في أمر الشراء.
/// تقييم المورد الشهري (الالتزام، العيوب، فارق السعر) يحتاج كياناً يُجمَع
/// عليه تاريخُه، واسمٌ مكتوب بأربع صيغ في أربعة أوامر شراء لا يُجمَع عليه شيء.
model Supplier {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  contactName  String?   @map("contact_name")
  contactPhone String?   @map("contact_phone")
  country      String?
  /// مهلة التوريد المتوقَّعة بالأيام — أساس احتساب نقطة إعادة الطلب
  leadTimeDays Int       @default(14) @map("lead_time_days")
  notes        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

/// أمر الشراء — كان يُخزَّن في `audit_logs` وهو العيب نفسه الذي أُصلح في
/// مطالبات الكفالة: حالةٌ تُستنتج من سطور سجل، ولا استعلام عليها، وتضيع
/// لو نُظّف السجل. السجل للتدقيق، والحالة للجداول.
model PurchaseOrder {
  id              String             @id @default(uuid())
  poNo            String             @unique @map("po_no")
  supplierId      String             @map("supplier_id")
  state           String @default("CONFIRMED")
  /// قيمة البضاعة وحدها بسنتات الدولار
  goodsUsdCents   BigInt             @map("goods_usd_cents")
  /// شحن وجمارك ورسوم — تُوزَّع على الوحدات بالقيمة لا بالعدد
  extraUsdCents   BigInt             @default(0) @map("extra_usd_cents")
  totalUsdCents   BigInt             @map("total_usd_cents")
  /// معامل التحميل بأجزاء المليون: 139276 = 13.9276%
  landedFactorPpm Int                @default(0) @map("landed_factor_ppm")
  expectedAt      DateTime?          @map("expected_at")
  receivedAt      DateTime?          @map("received_at")
  createdById     String?            @map("created_by_id")
  note            String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([state, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                     String @id @default(uuid())
  poId                   String @map("po_id")
  variantId              String @map("variant_id")
  qty                    Int
  qtyReceived            Int    @default(0) @map("qty_received")
  unitCostUsdCents       BigInt @map("unit_cost_usd_cents")
  /// التكلفة الشاملة بعد توزيع الإضافات — وهي أساس هامش الربح الحقيقي
  landedUnitCostUsdCents BigInt @map("landed_unit_cost_usd_cents")

  po      PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([poId, variantId])
  @@index([variantId])
  @@map("purchase_order_lines")
}

// ——————————————————— قائمة الرغبات (الفصل 14) ———————————————————

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  variantId String   @map("variant_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@index([userId])
  @@map("wishlist_items")
}

// ——————————————————— الجلسات وحذف الحساب (الفصل 9) ———————————————————

/// جلسة لكل تسجيل دخول.
/// `token_version` يُبطل كل الجلسات دفعةً واحدة، وهو سلاح ثقيل: من ضاع
/// هاتفه يريد إسقاط ذلك الجهاز وحده لا إخراج نفسه من كل أجهزته.
model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  /// يُحمل في مطالبة `sid` داخل الرمزين معاً
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// طلب حذف الحساب — بند الجاهزية 25.
/// الحذف لا يكون فورياً ولا صامتاً: مهلةٌ معلنة، وسجلٌ لما حُذف وما بقي،
/// لأن فاتورةً صدرت لا تُمحى وكفالةً سارية لا تسقط بحذف الحساب.
model AccountDeletionRequest {
  id          String               @id @default(uuid())
  userId      String               @map("user_id")
  state       String @default("PENDING")
  reason      String?
  requestedAt DateTime             @default(now()) @map("requested_at")
  /// يُنفَّذ بعدها ما لم يُلغَ الطلب — ثلاثون يوماً كما في سياسة الخصوصية
  dueAt       DateTime             @map("due_at")
  completedAt DateTime?            @map("completed_at")
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state, dueAt])
  @@map("account_deletion_requests")
}

// ——————————————————— الجاهزية والمهام الدورية (الفصل 19 §19.5) ———————————————————

/// بنود الجاهزية صفوفٌ في قاعدة البيانات لا وثيقة خارجية:
/// وثيقةٌ في ملف تُقرأ مرة وتُنسى، وصفٌّ بحالةٍ يمنع الإطلاق حتى يُحسم.
model ReadinessCheck {
  id           String            @id @default(uuid())
  code         String            @unique
  category     String
  title        Json
  isBlocking   Boolean           @default(true) @map("is_blocking")
  ownerRole    String            @map("owner_role")
  evidenceUrl  String?           @map("evidence_url")
  status       String   @default("PENDING")
  checkedById  String?           @map("checked_by_id")
  checkedAt    DateTime?         @map("checked_at")
  /// إلزامي عند WAIVED: تجاوزُ بندٍ بلا سبب مكتوب هو إخفاؤه لا حسمه
  waiverReason String?           @map("waiver_reason")
  sortOrder    Int               @default(0) @map("sort_order")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  checkedBy User? @relation(fields: [checkedById], references: [id])

  @@index([category, sortOrder])
  @@map("readiness_checks")
}

/// تنفيذ المهام الدورية في 19.2 — القيد الفريد يمنع ازدواج التنفيذ
model OpsRoutineRun {
  id            String           @id @default(uuid())
  routineCode   String           @map("routine_code")
  cadence       String
  /// 2026-07-28 أو 2026-W31 أو 2026-07
  periodKey     String           @map("period_key")
  performedById String?          @map("performed_by_id")
  isAutomated   Boolean          @default(false) @map("is_automated")
  status        String @default("DONE")
  notes         String?
  completedAt   DateTime         @default(now()) @map("completed_at")

  performedBy User? @relation(fields: [performedById], references: [id])

  @@unique([routineCode, periodKey])
  @@index([cadence, periodKey])
  @@map("ops_routine_runs")
}