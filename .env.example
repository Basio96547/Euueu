# تالي شام — متغيّرات التطوير المحلي
#
# لا رابط قاعدة بيانات هنا: القاعدة D1، وتُربط في wrangler.jsonc باسمها لا
# برابط اتصال. وهذا ليس تفصيلاً شكلياً: قاعدةٌ بلا منفذ مفتوح لا تُهاجَم من
# الإنترنت، ولا تحتاج جداراً نارياً، ولا كلمة سرّ تُدوَّر.
#
# أسرار الإنتاج تُضبط بـ`wrangler secret put` ولا تُكتب في ملف أبداً،
# ومحلياً في `.dev.vars` (مستبعَد من Git).

# ——— بناء الموقع الساكن ———
PUBLIC_SITE_URL="http://localhost:8787"

# ——— توقيع الجلسات ———
# في الإنتاج: نصّ عشوائي طويل عبر `wrangler secret put JWT_SECRET`
JWT_SECRET="dev_only_change_me"

# ——— واتساب: القناة تعمل بالمحاكاة حتى يُضبط المفتاح ———
# WHATSAPP_PROVIDER_TOKEN=""
# WHATSAPP_PHONE_ID=""

# ——— إشعارات المتصفح ———
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# ——— حساب الإدارة الأوّلي عند البذر ———
ADMIN_PHONE="+963958436703"

# ——— التطوير فقط ———
# يرفع سقف حدود المعدل ليمرّ الفحص من طرف إلى طرف، ويُتجاهَل في الإنتاج
RATE_LIMIT_FACTOR="100"
NODE_ENV="development"
