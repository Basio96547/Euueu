# ——— قاعدة البيانات ———
DATABASE_URL="postgresql://postgres:dev_only_pw@localhost:5432/talisham?schema=public"

# ——— الخدمات المساندة ———
REDIS_URL="redis://localhost:6379"
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev_master_key"        # سرّي
MEILI_SEARCH_KEY="dev_search_key"        # مفتاح قراءة يُسلَّم للمتصفح

# ——— التخزين ———
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="talisham-media"
S3_ACCESS_KEY="minioadmin"               # سرّي
S3_SECRET_KEY="minioadmin"               # سرّي

# ——— العناوين العامة ———
PUBLIC_SITE_URL="http://localhost:4321"
PUBLIC_API_URL="http://localhost:4000/api/v1"

# ——— الهوية ———
JWT_SECRET="dev_only_change_me"          # سرّي
OTP_LENGTH=6
OTP_TTL_SECONDS=300
# رقم الحساب الإداري الأول — يُنشئه البذر ليمكن دخول لوحة التحكم.
# غيّره إلى رقمك قبل أول بذر في الإنتاج، أو رقِّ لاحقاً بـ pnpm --filter @talisham/api grant-role
ADMIN_PHONE="+963900000001"

# ——— قنوات الإشعار (الفصل 20) ———
WHATSAPP_PROVIDER_TOKEN=""               # سرّي — فارغ محلياً فتُكتب الرسائل في السجل
SMS_PROVIDER_TOKEN=""                    # سرّي
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""                     # سرّي

# ——— أوضاع التشغيل ———
NODE_ENV="development"
DEMO_MODE="true"                         # يسمح بظهور منتجات البذرة التجريبية
