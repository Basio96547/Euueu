{
  // تالي شام — Worker واحد يخدم الموقع والتطبيق واللوحة والواجهة البرمجية.
  //
  // كانت أربعة Workers: الموقع وحده كان له نطاق، والتطبيق واللوحة بلا
  // مسار (فـ‎/app/cart‎ ترجع 404 على النطاق الحيّ)، والواجهة البرمجية بلا
  // استضافة أصلاً. أصلٌ واحد يُنهي ذلك كله ويُلغي الحاجة إلى CORS.
  //
  // النشر: pnpm run build:worker && npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talisham",
  "main": "apps/api/dist/worker.js",
  "compatibility_date": "2026-07-01",
  // Prisma ومحوّل pg يحتاجان واجهات Node داخل الـWorker
  "compatibility_flags": ["nodejs_compat"],

  // قاعدة البيانات: ربطٌ لا رابط اتصال — القاعدة لا تُعرَّض للإنترنت أصلاً
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talisham",
      "database_id": "d46eb676-f8fd-4f1e-9bca-894d500d4c93",
      "migrations_dir": "apps/api/migrations"
    }
  ],

  // رموز الدخول ومفاتيح التفرّد وعدّادات الحدّ: عزلةُ Worker تُهدَم بلا
  // إشعار، فالعدّاد في ذاكرتها ليس عدّاداً
  "kv_namespaces": [
    { "binding": "KV", "id": "d1f087f3301147dd89763f412b01b30b" }
  ],

  // صور المنتجات — تُخدَم من /media/* على الأصل نفسه.
  // الحاوية `talisham-media` مُنشأة وجاهزة، والربط معطَّل حتى ينال مفتاح
  // النشر صلاحية R2: wrangler يتحقّق من كل ربط عند النشر، فربطٌ بلا
  // صلاحية يُسقط النشرة كاملةً. والشيفرة تحتمل غيابه وتقول سببه:
  // رفع صورة بلا ربط يردّ MEDIA_BUCKET_MISSING لا خطأً غامضاً.
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "talisham-media" }
  // ],

  "assets": {
    "directory": "./dist-worker",
    "binding": "ASSETS",
    // الاحتياط للتطبيقين يُدار في الشيفرة: لكلٍّ صفحته لا صفحة واحدة للكل
    "not_found_handling": "404-page",
    //
    // خدمة الأصول تسبق الـWorker افتراضياً: ملفٌّ موجود يُخدَم مباشرةً
    // ولا تُستدعى الشيفرة أصلاً. وهذا صحيحٌ للأداء وخاطئٌ لنا: حقنُ سعر
    // الصرف في الصفحة لم يكن يُنفَّذ لأن الصفحة لا تمرّ به — وهو عطلٌ
    // صامت، لا خطأ فيه ولا سجلّ، ولا يظهر إلا بقياس ما يخرج فعلاً.
    //
    // فتُقلَب الأولوية على الصفحات وحدها. والأصول المبصومة مستثناة:
    // اسمها بصمةُ محتواها فلا يتغيّر مضمونها أبداً، ومرورُها بالـWorker
    // استدعاءٌ بلا أثر.
    "run_worker_first": ["/*", "!/_astro/*", "!/app/assets/*", "!/admin/assets/*"]
  },

  "observability": { "enabled": true },

  "vars": {
    "PUBLIC_SITE_URL": "https://talisham.com",
    "NODE_ENV": "production"
  },

  // الكنس كل دقيقة: الحجز المرن يموت بعد ربع ساعة، والموت تاريخٌ في صفّ
  // لا حدثٌ يقع من تلقائه — وبلا كنس يقول المتجر «نفدت» ورفّه ممتلئ.
  "triggers": {
    "crons": ["* * * * *"]
  }

  // النطاقات الثلاثة مربوطة أصلاً من لوحة Cloudflare، وإعادة تأكيدها هنا
  // تستدعي ‎/zones/…/workers/routes‎ التي يفتقر مفتاح النشر إلى صلاحيتها
  // (`code: 10000`). والنتيجة كانت أن كل نشرة تُرفع بنجاح ثم تُعلَن فاشلة
  // على خطوةٍ لا تُغيّر شيئاً — فيصير الأحمر في السجل بلا معنى، ولا يُميَّز
  // عطلٌ حقيقي حين يقع.
  //
  // يُعاد هذا القسم يوم ينال المفتاح صلاحية Workers Routes: Edit:
  // "routes": [
  //   { "pattern": "talisham.com", "custom_domain": true },
  //   { "pattern": "www.talisham.com", "custom_domain": true },
  //   { "pattern": "api.talisham.com", "custom_domain": true }
  // ]

  // الأسرار تُضبط خارج الملف ولا تُكتب فيه أبداً:
  //   npx wrangler secret put JWT_SECRET
  //   npx wrangler secret put WHATSAPP_PROVIDER_TOKEN
}
