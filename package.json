{
  "name": "talisham",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "dev:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @talisham/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @talisham/api exec prisma generate",
    "db:seed": "pnpm --filter @talisham/api run seed",
    "db:purge-demo": "pnpm --filter @talisham/api run purge-demo",
    "test": "turbo run test",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
