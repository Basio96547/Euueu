{
  "name": "talisham",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bash scripts/e2e.sh",
    "build:worker": "bash scripts/build-worker.sh",
    "worker:dev": "wrangler dev --port 8787",
    "deploy": "bash scripts/build-worker.sh && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply talisham --remote",
    "db:migrate:local": "wrangler d1 migrations apply talisham --local",
    "db:seed": "node apps/api/prisma/seed-d1.mjs > /tmp/talisham-seed.sql && wrangler d1 execute talisham --local --file=/tmp/talisham-seed.sql",
    "db:seed:remote": "node apps/api/prisma/seed-d1.mjs > /tmp/talisham-seed.sql && wrangler d1 execute talisham --remote --file=/tmp/talisham-seed.sql"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "wrangler": "4.115.0"
  }
}
